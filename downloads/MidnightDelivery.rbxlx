  <Item class="StarterPlayer" referent="40">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="41">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="42">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="43">
          <Properties>
            <string name="Name">Bootstrap</string>
            <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Names = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RemoteNames"))
local HUD = require(script.Parent.Controllers.HUDController)
local hud = HUD.start()
local stopSpawn = require(script.Parent.Controllers.SpawnController).start()
local folder = ReplicatedStorage:WaitForChild(Names.Folder, 30)
if not folder then
	hud.feedback("서버 초기화 실패 · Studio Output을 확인하세요")
	error("MidnightDelivery: Remotes unavailable after 30 seconds")
end
local stateRemote = folder:WaitForChild(Names.State)
local feedbackRemote = folder:WaitForChild(Names.Feedback)
local snapshotRemote = folder:WaitForChild(Names.Snapshot)
local settings=require(script.Parent.Controllers.SettingsController).start(folder:WaitForChild(Names.Action))
local disconnectSettings=settings.subscribe(hud.configure)
local controls = require(script.Parent.Controllers.InputController).start(folder:WaitForChild(Names.Action),settings)
local audio = require(script.Parent.Controllers.AudioController).start(settings)
local shop = require(script.Parent.Controllers.ShopController).start(folder:WaitForChild(Names.Action),settings)
local tutorial=require(script.Parent.Controllers.TutorialController).start(folder:WaitForChild(Names.Action),settings)
local latestVersion = -1
local function update(snapshot)
	if not snapshot or snapshot.version < latestVersion then return end
	latestVersion = snapshot.version
	settings.update(snapshot);hud.update(snapshot); controls.update(snapshot); audio.update(snapshot); shop.update(snapshot);tutorial.update(snapshot)
end
local stateConnection = stateRemote.OnClientEvent:Connect(update)
local feedbackConnection = feedbackRemote.OnClientEvent:Connect(hud.feedback)
-- 이벤트를 먼저 구독하여 초기 스냅샷 도중 발생한 상태 전환을 놓치지 않는다.
task.spawn(function()
	for attempt = 1, 3 do
		local ok, snapshot = pcall(function() return snapshotRemote:InvokeServer() end)
		if ok and snapshot then update(snapshot); return end
		task.wait(1.1)
	end
	hud.feedback("상태 동기화 실패 · 다시 입장하세요")
end)
script.Destroying:Connect(function()
	stateConnection:Disconnect()
	feedbackConnection:Disconnect()
	tutorial.destroy()
	disconnectSettings()
	shop.destroy()
	controls.destroy()
	audio.destroy()
	settings.destroy()
	hud.destroy()
	stopSpawn()
end)
print("[MidnightDelivery] Client GUI ready (P6)")
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="44">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--!strict
local SoundService = game:GetService("SoundService")
local Content = game:GetService("ContentProvider")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Catalog = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("AudioCatalog"))
local Types = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Types"))
local Controller = {}
function Controller.start(settings)
	local group = Instance.new("SoundGroup")
	group.Name, group.Volume, group.Parent = "MidnightAudio", 1, SoundService
	local sounds, connections = {}, {}
	local routed = setmetatable({}, {__mode = "k"})
	local stopped, muted = false, false
	local previous: Types.Snapshot? = nil
	for name, definition in Catalog do
		local sound = Instance.new("Sound")
		sound.Name, sound.SoundId, sound.Volume, sound.PlaybackSpeed = name, definition.id, definition.volume, definition.pitch
		sound.Looped, sound.SoundGroup, sound.Parent = name == "Wind" or name == "Motor", group, SoundService
		sounds[name] = sound
	end
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.ResetOnSpawn, gui.ScreenInsets = "MidnightAudioControls", false, Enum.ScreenInsets.CoreUISafeInsets
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local mute = Instance.new("TextButton")
	mute.Size, mute.Position, mute.Parent = UDim2.fromOffset(100,44), UDim2.new(1,-112,0,136), gui
	mute.BackgroundColor3, mute.TextColor3, mute.Font, mute.TextSize = Color3.fromRGB(27,39,64), Color3.fromRGB(246,244,235), Enum.Font.GothamMedium, 14
	mute.Text = "소리 켜짐"
	local corner = Instance.new("UICorner"); corner.Parent = mute
	if settings then settings.register(mute) end
	local function route(instance)
		if instance:IsA("Sound") and not instance.SoundGroup then instance.SoundGroup = group; routed[instance] = true end
	end
	for _, instance in workspace:GetDescendants() do route(instance) end
	table.insert(connections,workspace.DescendantAdded:Connect(route))
	table.insert(connections,mute.Activated:Connect(function()
		if settings then settings.set("muted",not settings.get().muted)
		else
			muted = not muted; group.Volume = if muted then 0 else 1
			mute.Text = if muted then "소리 꺼짐" else "소리 켜짐"
		end
	end))
	local disconnectSettings=nil
	if settings then disconnectSettings=settings.subscribe(function(options)
		muted=options.muted;group.Volume=if muted or options.loaded==false then 0 else 1
		mute.Text=if muted then "소리 꺼짐"else"소리 켜짐"
	end)end
	local function play(name: string)
		local sound = sounds[name]
		if sound then sound.TimePosition = 0; sound:Play() end
	end
	task.spawn(function()
		local list = {}; for _, sound in sounds do table.insert(list,sound) end
		local ok, err = pcall(function()
			Content:PreloadAsync(list,function(id,status)
				if not stopped and status ~= Enum.AssetFetchStatus.Success then warn("[MidnightDelivery] Audio unavailable: " .. id) end
			end)
		end)
		if not stopped then
			if not ok then warn("[MidnightDelivery] Audio preload failed: " .. tostring(err)) end
			sounds.Wind:Play()
		end
	end)
	local elapsed, dangerAt = 0, 0
	table.insert(connections,RunService.RenderStepped:Connect(function(dt)
		elapsed += dt; if elapsed < 0.1 then return end; elapsed = 0
		local p = Players.LocalPlayer
		local humanoid = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
		local seat = humanoid and humanoid.SeatPart
		local model = seat and seat.Parent
		local speed = if model then model:GetAttribute("Speed") or 0 else 0
		if speed > 1 then
			sounds.Motor.PlaybackSpeed = 0.65 + speed/38*0.9
			if not sounds.Motor.Playing then sounds.Motor:Play() end
		elseif sounds.Motor.Playing then sounds.Motor:Stop() end
		if previous and previous.chase.endsAt > workspace:GetServerTimeNow() and os.clock() > dangerAt then
			play("Danger"); dangerAt = os.clock()+1.2
		end
	end))
	return {
		update = function(snapshot: Types.Snapshot)
			if previous then
				if snapshot.coins > previous.coins then play("Success")
				elseif snapshot.downUntil > previous.downUntil and snapshot.downUntil > 0 then play("Down")
				elseif previous.downUntil > 0 and snapshot.downUntil == 0 then play("Recover")
				elseif snapshot.orderIndex ~= previous.orderIndex or (snapshot.phase == "PREPARING" and previous.phase ~= snapshot.phase) then play("Receipt") end
			end
			previous = snapshot
		end,
		destroy = function()
			stopped = true
			for _, connection in connections do connection:Disconnect() end
			for sound in routed do if sound.Parent and sound.SoundGroup == group then sound.SoundGroup = nil end end
			for _, sound in sounds do sound:Destroy() end
			if disconnectSettings then disconnectSettings()end
			mute:Destroy();group:Destroy(); gui:Destroy()
		end,
	}
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TweenService=game:GetService("TweenService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Strings = require(Shared:WaitForChild("Strings"))
local Types = require(Shared:WaitForChild("Types"))
local Factory = require(script.Parent.Parent.UI.UIFactory)
local HUD = {}

function HUD.start()
	local player = Players.LocalPlayer
	local ui = Factory.create(player:WaitForChild("PlayerGui"))
	local state: Types.Snapshot? = nil
	local collapsed, toastUntil = UIS.TouchEnabled, 0
	local connections = {}
	local options={reducedMotion=false,largeText=false}
	local previousMode,previousCompact=nil,nil
	local tween=nil
	local fontSizes={}
	for _,item in ui.gui:GetDescendants()do if item:IsA("TextLabel")or item:IsA("TextButton")then fontSizes[item]=item.TextSize end end
	local function render()
		if not state then return end
		ui.phase.Text = Strings[state.phase] or state.phase
		ui.stats.Text = string.format("Lv.%d · %d Coins · 팀 %d/4", state.level, state.coins, state.playerCount)
		ui.note.Text = if state.data.mode=="READY" then (if state.data.dirty then "변경 저장 대기 · 자동 저장" else "영구 저장 연결됨")
			elseif state.data.mode=="SAVING" then "저장 중…"
			elseif state.data.mode=="LOADING" then "프로필 로딩 중 · 참가 대기"
			elseif state.data.mode=="SAVE_ERROR" then "저장 실패 · 재시도 중 · 상점 잠김"
			else "세션 전용 · 이번 진행은 저장되지 않습니다"
		if state.phase == "RESULTS" then
			ui.title.Text = state.result
			ui.hint.Text = string.format("성공 %d / 실패 %d · +%d Coins\n잠시 후 다음 배달을 준비합니다.", state.successes, state.failures, state.reward)
		elseif not state.participant and state.phase ~= "WAITING" then
			ui.title.Text, ui.hint.Text = "로비 대기", Strings.Spectator
		elseif state.phase == "PLAYING" or state.phase == "PREPARING" then
			ui.title.Text, ui.hint.Text = state.orderTitle, state.orderHint
		else
			ui.title.Text, ui.hint.Text = Strings.Title, "자동으로 시작합니다.\n주문 확인 → 네온 길 따라 이동 → 현관 배달"
		end
		ui.hint.Visible = not collapsed
		ui.card.Size = UDim2.fromOffset(math.min(300, math.max(190, ui.root.AbsoluteSize.X - 140)), if collapsed then 42 else (if options.largeText then 164 else 142))
		ui.stats.Position = UDim2.fromOffset(16, if collapsed then 134 else (if options.largeText then 256 else 234))
		ui.note.Position = UDim2.fromOffset(16, if collapsed then 182 else (if options.largeText then 304 else 282))
		ui.toggle.Text = if collapsed then "주문 펼치기" else "주문 접기"
	end
	table.insert(connections, ui.toggle.Activated:Connect(function() collapsed = not collapsed; render() end))
	table.insert(connections, ui.root:GetPropertyChangedSignal("AbsoluteSize"):Connect(render))
	local elapsed = 0
	table.insert(connections, RunService.RenderStepped:Connect(function(delta)
		elapsed += delta
		if elapsed < 0.1 then return end
		elapsed = 0
		local now = workspace:GetServerTimeNow()
		if now > toastUntil then ui.toast.Text = "" end
		if not state then return end
		if state.downUntil > now then
			ui.recovery.Text = string.format("기절 · %d초 후 자동 복귀\n팀원이 3초간 눌러 구조할 수 있습니다", math.ceil(state.downUntil - now))
		elseif state.protectedUntil > now then ui.recovery.Text = string.format("보호 중 · %d초", math.ceil(state.protectedUntil - now))
		elseif state.chase.endsAt > now then
			ui.recovery.Text = if state.chase.targetId == player.UserId then "괴물이 쫓아옵니다! 도로를 따라 도망치세요" else "팀원이 추격당하고 있습니다!"
		else ui.recovery.Text = "" end
		local members = {}
		for _, member in state.members do
			local cut=utf8.offset(member.name,11)
			local name=if cut then string.sub(member.name,1,cut-1).."…"else member.name
			table.insert(members, name .. (if member.downUntil > now then " · 구조 필요" else " · 정상"))
		end
		ui.team.Text = table.concat(members, "  /  ")
		local compactTeam=UIS.TouchEnabled or ui.root.AbsoluteSize.Y<500
		ui.team.Visible=not compactTeam
		if compactTeam then
			local down=0;for _,member in state.members do if member.downUntil>now then down+=1 end end
			ui.stats.Text=string.format("Lv.%d · %d Coins\n참가 %d명 · 구조 필요 %d명",state.level,state.coins,#state.members,down)
		end
		if state.phase == "PLAYING" and state.participant then
			local detail = state.orderHint
			if state.stage == "HOLDING" then detail = string.format("문을 향한 채 그대로! %d초", math.max(0, math.ceil(state.holdUntil - now)))
			elseif state.stage == "COOLDOWN" then detail = string.format("규칙 위반 · %d초 후 재시도", math.max(0, math.ceil(state.cooldownUntil - now)))
			elseif state.late then detail = "음식이 식었습니다 · 현관에서 3초간 진정시키기"
			elseif state.hotUntil > 0 then detail = string.format("음식 온도 %d%% · 식기 전에 현관으로!", math.clamp(math.ceil((state.hotUntil - now) / 90 * 100), 0, 100))
			elseif string.find(state.orderTitle, "유령") then detail = string.format("노크 %d/3 · 세 번째 노크 후 4초 정면 유지", state.knocks) end
			ui.hint.Text = detail .. string.format("\n주문 남은 시간 %d초", math.max(0, math.ceil(state.orderEndsAt - now)))
			ui.phase.Text = string.format("배달 %d/3 · 성공 %d", state.orderIndex, state.successes)
		end
		local seconds = math.max(0, math.ceil(state.endsAt - now))
		ui.timer.Text = if state.endsAt == 0 then "대기" else string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local camera = workspace.CurrentCamera
		local active = state.participant and state.orderActive and root ~= nil and camera ~= nil
		ui.arrow.Visible, ui.distance.Visible = active, active
		if not active or not root or not root:IsA("BasePart") or not camera then return end
		local target = state.target
		if not target then return end
		local projected, onScreen = camera:WorldToViewportPoint(target)
		-- 뒤쪽 목표는 투영 방향을 반전해 화면 가장자리에 안내한다.
		local center = ui.root.AbsoluteSize / 2
		local localPoint = Vector2.new(projected.X, projected.Y) - ui.root.AbsolutePosition
		local direction = localPoint - center
		if projected.Z < 0 then direction = -direction end
		if direction.Magnitude < 1 then direction = Vector2.new(0, -1) end
		local unit = direction.Unit
		local limit = Vector2.new(math.max(40, center.X - 40), math.max(40, center.Y - 50))
		local radius = math.min(limit.X / math.max(math.abs(unit.X), 0.001), limit.Y / math.max(math.abs(unit.Y), 0.001))
		local point = if onScreen then localPoint else center + unit * radius
		point = Vector2.new(math.clamp(point.X, 32, center.X * 2 - 32), math.clamp(point.Y, 84, center.Y * 2 - 50))
		ui.arrow.Position, ui.arrow.Rotation = UDim2.fromOffset(point.X, point.Y), math.deg(math.atan2(unit.Y, unit.X)) + 90
		ui.distance.Position = UDim2.fromOffset(math.clamp(point.X, 105, math.max(105, center.X * 2 - 105)), point.Y + 22)
		ui.distance.Text = string.format("목적지 · %d studs", math.floor((root.Position - target).Magnitude))
	end))
	ui.arrow.Visible, ui.distance.Visible = false, false
	return {
		configure=function(value)
			options=value
			if value.hudMode~=previousMode or value.compactHUD~=previousCompact then collapsed=value.compactHUD end
			previousMode,previousCompact=value.hudMode,value.compactHUD
			for item,size in fontSizes do item.TextSize=math.floor(size*(if value.largeText then 1.15 else 1)+0.5)end
			if value.reducedMotion and tween then tween:Cancel();tween=nil;ui.toast.TextTransparency=0 end
			render()
		end,
		update = function(snapshot: Types.Snapshot?)
			if not snapshot or (state and snapshot.version < state.version) then return end
			state = snapshot
			render()
		end,
		feedback = function(message: string)
			if tween then tween:Cancel();tween=nil end
			ui.toast.Text, toastUntil = message, workspace:GetServerTimeNow() + 4
			ui.toast.TextTransparency=if options.reducedMotion then 0 else 1
			if not options.reducedMotion then
				tween=TweenService:Create(ui.toast,TweenInfo.new(0.2,Enum.EasingStyle.Quad),{TextTransparency=0});tween:Play()
			end
		end,
		destroy = function()
			for _, connection in connections do connection:Disconnect() end
			if tween then tween:Cancel()end
			ui.gui:Destroy()
		end,
	}
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Types = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Types"))
local Controller = {}
function Controller.start(remote: RemoteEvent,settings)
	local player = Players.LocalPlayer
	local state: Types.Snapshot? = nil
	local focused = true
	local connections, inputs, held = {}, {}, {}
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.ResetOnSpawn, gui.ScreenInsets = "MidnightControls", false, Enum.ScreenInsets.CoreUISafeInsets
	gui.Parent = player:WaitForChild("PlayerGui")
	local drive = Instance.new("Frame")
	drive.BackgroundTransparency, drive.Size, drive.AnchorPoint = 1, UDim2.fromOffset(164,104), Vector2.new(0.5,1)
	drive.Position, drive.Parent = UDim2.new(0.53,0,1,-16), gui
	local function send(kind: string, extra: { [string]: any }?)
		if not state then return end
		local payload = extra or {}
		payload.kind, payload.roundId = kind, state.roundId
		remote:FireServer(payload)
	end
	local function button(parent: Instance, label: string, position: UDim2, size: UDim2)
		local b = Instance.new("TextButton")
		b.Text, b.Position, b.Size, b.Parent = label, position, size, parent
		b.BackgroundColor3, b.TextColor3, b.TextSize, b.Font = Color3.fromRGB(27,39,64), Color3.fromRGB(246,244,235), 16, Enum.Font.GothamMedium
		local corner = Instance.new("UICorner"); corner.Parent = b
		return b
	end
	local function holdButton(parent, label, name, position)
		local b = button(parent,label,position,UDim2.fromOffset(48,48))
		table.insert(connections,b.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
			inputs[input] = name; held[name] = (held[name] or 0) + 1
		end))
		return b
	end
	holdButton(drive,"↑", "Forward",UDim2.fromOffset(56,0))
	holdButton(drive,"←", "Left",UDim2.fromOffset(0,54))
	holdButton(drive,"↓", "Reverse",UDim2.fromOffset(56,54))
	holdButton(drive,"→", "Right",UDim2.fromOffset(112,54))
	local sprint = holdButton(gui,"달리기","Sprint",UDim2.new(1,-82,1,-160))
	sprint.Size = UDim2.fromOffset(70,48)
	local leave = button(gui,"하차",UDim2.new(1,-82,1,-160),UDim2.fromOffset(70,48))
	local reset = button(gui,"차량 복구",UDim2.new(1,-124,0,188),UDim2.fromOffset(112,44))
	if settings then settings.register(reset)end
	table.insert(connections,leave.Activated:Connect(function() send("ExitVehicle") end))
	table.insert(connections,reset.Activated:Connect(function() send("ResetVehicle") end))
	table.insert(connections,UIS.InputEnded:Connect(function(input)
		local name = inputs[input]
		if name then held[name] = math.max(0,(held[name] or 0)-1); inputs[input] = nil end
	end))
	table.insert(connections,UIS.WindowFocusReleased:Connect(function()
		focused = false; table.clear(held); table.clear(inputs)
		send("Sprint",{enabled=false}); send("VehicleInput",{throttle=0,steer=0})
	end))
	table.insert(connections,UIS.WindowFocused:Connect(function() focused = true end))
	table.insert(connections,UIS.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.Space then send("ExitVehicle") end
	end))
	local elapsed, sprintElapsed = 0, 0
	table.insert(connections,RunService.RenderStepped:Connect(function(dt)
		elapsed += dt; sprintElapsed += dt
		if elapsed < 0.1 then return end
		elapsed = 0
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local seat = humanoid and humanoid.SeatPart
		local riding = seat ~= nil and seat:IsA("VehicleSeat")
		local down = state and state.downUntil > workspace:GetServerTimeNow()
		drive.Visible = UIS.TouchEnabled and riding and not down
		leave.Visible, sprint.Visible = riding and not down, not riding and not down
		reset.Visible = state ~= nil and state.vehicle.owned and (state.phase == "WAITING" or state.participant) and not down
		if state then
			local cooldown = math.max(0,math.ceil(state.vehicle.resetAt-workspace:GetServerTimeNow()))
			reset.Text = if cooldown > 0 then "복구 " .. cooldown .. "초" else "차량 복구"
		end
		sprint.Text = string.format("달리기\n%d%%",math.floor((player:GetAttribute("Stamina") or 5)*20))
		local function pressed(name) return (held[name] or 0) > 0 end
		local typing = UIS:GetFocusedTextBox() ~= nil or (settings and settings.get().menuOpen==true)
		if sprintElapsed >= 0.3 then
			sprintElapsed = 0
			send("Sprint",{enabled=focused and not typing and not riding and not down and (pressed("Sprint") or UIS:IsKeyDown(Enum.KeyCode.LeftShift))})
		end
		if riding and seat and seat:IsA("VehicleSeat") then
			local throttle = if focused and not typing then seat.ThrottleFloat else 0
			local steer = if focused and not typing then seat.SteerFloat else 0
			if focused and not typing then
				if pressed("Forward") or UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up) then throttle = 1 end
				if pressed("Reverse") or UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down) then throttle = -1 end
				if pressed("Left") or UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.Left) then steer = -1 end
				if pressed("Right") or UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Right) then steer = 1 end
			end
			send("VehicleInput",{throttle=throttle,steer=steer})
		end
	end))
	return {
		update = function(snapshot: Types.Snapshot) state = snapshot end,
		destroy = function() for _, connection in connections do connection:Disconnect() end; reset:Destroy(); gui:Destroy() end,
	}
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">SettingsController</string>
              <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local UIS=game:GetService("UserInputService")
local Controller={}
function Controller.start(remote: RemoteEvent)
	local prefs={muted=false,reducedMotion=false,largeText=false,hudMode="auto"}
	local pending,subscribers,connections={}, {},{}
	local state=nil
	local gui=Instance.new("ScreenGui")
	gui.Name,gui.ResetOnSpawn,gui.DisplayOrder,gui.ScreenInsets="MidnightSettings",false,25,Enum.ScreenInsets.CoreUISafeInsets
	gui.Parent=Players.LocalPlayer:WaitForChild("PlayerGui")
	local function button(parent,text)
		local b=Instance.new("TextButton")
		b.Text,b.Size,b.BackgroundColor3,b.TextColor3,b.Font,b.TextSize,b.Parent=text,UDim2.new(1,0,0,44),Color3.fromRGB(27,39,64),Color3.fromRGB(246,244,235),Enum.Font.GothamMedium,15,parent
		local c=Instance.new("UICorner");c.Parent=b
		return b
	end
	local gear=button(gui,"메뉴")
	gear.Size,gear.Position=UDim2.fromOffset(44,44),UDim2.new(1,-56,0,16)
	local drawer=Instance.new("ScrollingFrame")
	drawer.AnchorPoint,drawer.Position,drawer.Size=Vector2.new(1,0),UDim2.new(1,-12,0,68),UDim2.new(0,210,1,-84)
	drawer.BackgroundColor3,drawer.BorderSizePixel,drawer.Visible,drawer.Parent=Color3.fromRGB(17,25,44),0,false,gui
	drawer.Active=true
	drawer.CanvasSize,drawer.AutomaticCanvasSize,drawer.ScrollBarThickness=UDim2.new(),Enum.AutomaticSize.Y,4
	local constraint=Instance.new("UISizeConstraint");constraint.MaxSize,constraint.Parent=Vector2.new(210,276),drawer
	local padding=Instance.new("UIPadding");padding.PaddingLeft,padding.PaddingRight,padding.PaddingTop,padding.PaddingBottom=UDim.new(0,8),UDim.new(0,8),UDim.new(0,8),UDim.new(0,8);padding.Parent=drawer
	local layout=Instance.new("UIListLayout");layout.Padding,layout.SortOrder,layout.Parent=UDim.new(0,8),Enum.SortOrder.LayoutOrder,drawer
	local panel=Instance.new("ScrollingFrame")
	panel.Active=true
	panel.CanvasSize,panel.AutomaticCanvasSize,panel.ScrollBarThickness=UDim2.new(),Enum.AutomaticSize.Y,4
	panel.AnchorPoint,panel.Position,panel.Size,panel.BackgroundColor3,panel.Visible,panel.Parent=Vector2.new(0.5,0.5),UDim2.fromScale(0.5,0.5),UDim2.new(1,-24,1,-24),Color3.fromRGB(17,25,44),false,gui
	local limit=Instance.new("UISizeConstraint");limit.MaxSize,limit.Parent=Vector2.new(420,334),panel
	local pad=Instance.new("UIPadding");pad.PaddingTop,pad.PaddingBottom,pad.PaddingLeft,pad.PaddingRight=UDim.new(0,10),UDim.new(0,10),UDim.new(0,10),UDim.new(0,10);pad.Parent=panel
	local list=Instance.new("UIListLayout");list.Padding,list.Parent=UDim.new(0,7),panel
	local status=Instance.new("TextLabel")
	status.Size,status.BackgroundTransparency,status.TextColor3,status.TextWrapped,status.TextSize,status.Parent=UDim2.new(1,0,0,44),1,Color3.fromRGB(246,244,235),true,14,panel
	local controls={}
	for _,key in {"muted","reducedMotion","largeText","hudMode"}do controls[key]=button(panel,"")end
	local close=button(panel,"닫기")
	local index=0
	local function register(b)
		index+=1;b.LayoutOrder=index;b.Position=UDim2.new();b.Size=UDim2.new(1,-4,0,44);b.Parent=drawer
		table.insert(connections,b.Activated:Connect(function()drawer.Visible=false end))
	end
	local open=button(gui,"화면·접근성 설정");register(open)
	local function get()
		local value=table.clone(prefs)
		value.loaded=state~=nil and state.data.mode~="LOADING"
		value.menuOpen=drawer.Visible or panel.Visible
		value.compactHUD=if prefs.hudMode=="auto"then UIS.TouchEnabled else prefs.hudMode=="compact"
		return value
	end
	local function redraw()
		controls.muted.Text="소리: "..(if prefs.muted then "꺼짐"else"켜짐")
		controls.reducedMotion.Text="알림 애니메이션: "..(if prefs.reducedMotion then "줄이기"else"기본")
		controls.largeText.Text="HUD 글자: "..(if prefs.largeText then "크게"else"기본")
		controls.hudMode.Text="주문 카드: "..(if prefs.hudMode=="auto"then"기기 자동"elseif prefs.hudMode=="compact"then"접기"else"펼치기")
		status.Text=if state and (state.data.mode=="READY" or state.data.mode=="SAVING")then "화면 설정 · 자동 저장"else"화면 설정 · 현재 접속에 적용 · 저장 미연결"
		for _,fn in subscribers do fn(get())end
	end
	local function set(key,value)
		prefs[key]=value;pending[key]={value=value,time=os.clock(),sent=state~=nil and state.data.mode~="LOADING"}
		if state and state.data.mode~="LOADING"then remote:FireServer({kind="SetPreference",roundId=state.roundId,key=key,value=value})end
		redraw()
	end
	for _,key in {"muted","reducedMotion","largeText"}do table.insert(connections,controls[key].Activated:Connect(function()set(key,not prefs[key])end))end
	table.insert(connections,controls.hudMode.Activated:Connect(function()set("hudMode",if prefs.hudMode=="auto"then"compact"elseif prefs.hudMode=="compact"then"expanded"else"auto")end))
	table.insert(connections,gear.Activated:Connect(function()drawer.Visible=not drawer.Visible;panel.Visible=false end))
	table.insert(connections,open.Activated:Connect(function()panel.Visible=true end))
	table.insert(connections,close.Activated:Connect(function()panel.Visible=false end))
	redraw()
	return {
		get=get,set=set,register=register,
		subscribe=function(fn)table.insert(subscribers,fn);fn(get());return function()local i=table.find(subscribers,fn);if i then table.remove(subscribers,i)end end end,
		update=function(snapshot)
			state=snapshot
			if snapshot.data.mode~="LOADING"then
				for key,value in snapshot.preferences do
					local p=pending[key]
					if p and not p.sent then remote:FireServer({kind="SetPreference",roundId=snapshot.roundId,key=key,value=p.value});p.sent=true;p.time=os.clock()end
					if not p or p.value==value or os.clock()-p.time>3 then prefs[key]=value;pending[key]=nil end
				end
			end
			redraw()
		end,
		destroy=function()for _,c in connections do c:Disconnect()end;table.clear(subscribers);gui:Destroy()end,
	}
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Catalog=require(Shared:WaitForChild("Catalogs"))
local Types=require(Shared:WaitForChild("Types"))
local Controller={}
function Controller.start(remote: RemoteEvent,settings)
	local state: Types.Snapshot?=nil
	local connections,rows={},{}
	local gui=Instance.new("ScreenGui")
	gui.Name,gui.ResetOnSpawn,gui.DisplayOrder,gui.ScreenInsets="MidnightShop",false,20,Enum.ScreenInsets.CoreUISafeInsets
	gui.Parent=Players.LocalPlayer:WaitForChild("PlayerGui")
	local function label(parent,text,position,size,fontSize)
		local l=Instance.new("TextLabel")
		l.Text,l.Position,l.Size,l.TextSize,l.Parent=text,position,size,fontSize,parent
		l.BackgroundTransparency,l.TextColor3,l.TextWrapped,l.Font=1,Color3.fromRGB(246,244,235),true,Enum.Font.GothamMedium
		l.TextXAlignment=Enum.TextXAlignment.Left
		return l
	end
	local function button(parent,text,position,size)
		local b=Instance.new("TextButton")
		b.Text,b.Position,b.Size,b.Parent=text,position,size,parent
		b.BackgroundColor3,b.TextColor3,b.TextSize,b.Font=Color3.fromRGB(255,170,69),Color3.fromRGB(17,25,44),15,Enum.Font.GothamBold
		local c=Instance.new("UICorner");c.Parent=b
		return b
	end
	local open=button(gui,"꾸미기 상점",UDim2.new(1,-124,0,240),UDim2.fromOffset(112,44))
	if settings then settings.register(open)end
	local overlay=Instance.new("Frame")
	overlay.Size,overlay.BackgroundColor3,overlay.BackgroundTransparency,overlay.Visible,overlay.Parent=UDim2.fromScale(1,1),Color3.fromRGB(5,8,18),0.2,false,gui
	overlay.Active=true
	local panel=Instance.new("Frame")
	panel.Size,panel.AnchorPoint,panel.Position=UDim2.new(1,-24,1,-24),Vector2.new(0.5,0.5),UDim2.fromScale(0.5,0.5)
	panel.BackgroundColor3,panel.BorderSizePixel,panel.Parent=Color3.fromRGB(27,39,64),0,overlay
	local limit=Instance.new("UISizeConstraint");limit.MaxSize,limit.Parent=Vector2.new(520,430),panel
	local corner=Instance.new("UICorner");corner.Parent=panel
	label(panel,"야식 본부 · 꾸미기",UDim2.fromOffset(14,6),UDim2.new(1,-76,0,32),20)
	local close=button(panel,"닫기",UDim2.new(1,-68,0,5),UDim2.fromOffset(58,44))
	local balance=label(panel,"",UDim2.fromOffset(14,42),UDim2.new(1,-28,0,26),15)
	local note=label(panel,"",UDim2.fromOffset(14,72),UDim2.new(1,-28,0,40),12)
	local list=Instance.new("ScrollingFrame")
	list.Position,list.Size,list.BackgroundTransparency,list.BorderSizePixel=UDim2.fromOffset(10,120),UDim2.new(1,-20,1,-130),1,0
	list.CanvasSize,list.AutomaticCanvasSize,list.ScrollBarThickness,list.Parent=UDim2.new(),Enum.AutomaticSize.Y,5,panel
	local layout=Instance.new("UIListLayout");layout.Padding,layout.Parent=UDim.new(0,8),list
	for index,item in Catalog do
		local card=Instance.new("Frame")
		card.Size,card.BackgroundColor3,card.BorderSizePixel,card.LayoutOrder,card.Parent=UDim2.new(1,-8,0,84),Color3.fromRGB(40,54,80),0,index,list
		local c=Instance.new("UICorner");c.Parent=card
		label(card,item.name,UDim2.fromOffset(10,5),UDim2.new(1,-125,0,28),16)
		label(card,item.description.." · Lv."..item.level,UDim2.fromOffset(10,35),UDim2.new(1,-125,0,42),12)
		local action=button(card,"",UDim2.new(1,-112,0,20),UDim2.fromOffset(102,46))
		rows[item.id]=action
		table.insert(connections,action.Activated:Connect(function()
			if not state or state.data.mode~="READY" then return end
			if state.owned[item.id] then remote:FireServer({kind="EquipCosmetic",roundId=state.roundId,itemId=item.id,enabled=state.equipped[item.slot]~=item.id})
			elseif state.coins>=item.price and state.level>=item.level then remote:FireServer({kind="PurchaseWithCoins",roundId=state.roundId,itemId=item.id}) end
		end))
	end
	table.insert(connections,open.Activated:Connect(function()overlay.Visible=not overlay.Visible end))
	table.insert(connections,close.Activated:Connect(function()overlay.Visible=false end))
	return {
		update=function(snapshot: Types.Snapshot)
			state=snapshot
			open.Visible=snapshot.downUntil<=workspace:GetServerTimeNow() and not snapshot.vehicle.seated
			if not open.Visible then overlay.Visible=false end
			balance.Text=string.format("Lv.%d · %d XP · %d Coins",snapshot.level,snapshot.xp,snapshot.coins)
			note.Text=if snapshot.data.mode=="READY" then (if snapshot.data.dirty then "변경 저장 대기 · 라운드는 계속 진행됩니다" else "Coins 전용 상점 · 라운드는 계속 진행됩니다")
				elseif snapshot.data.mode=="SAVING" then "저장 중입니다. 잠시 기다려주세요."
				else "상점 잠김 · 프로필 로딩/저장 연결을 확인하세요. 세션 전용 데이터는 저장하지 않습니다."
			for _,item in Catalog do
				local b=rows[item.id]
				b.AutoButtonColor=snapshot.data.mode=="READY"
				b.Text=if snapshot.data.mode~="READY" then "잠김"
					elseif snapshot.owned[item.id] then (if snapshot.equipped[item.slot]==item.id then "해제" else "장착")
					elseif snapshot.level<item.level then "Lv."..item.level.." 필요"
					elseif snapshot.coins<item.price then item.price.." Coins\n잔액 부족" else item.price.." Coins"
			end
		end,
		destroy=function()for _,connection in connections do connection:Disconnect()end;open:Destroy();gui:Destroy()end,
	}
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">SpawnController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Controller = {}
function Controller.start()
	local player = Players.LocalPlayer
	local stopped = false
	local function orient(character: Model)
		task.spawn(function()
			local root = character:WaitForChild("HumanoidRootPart", 10)
			local humanoid = character:WaitForChild("Humanoid", 10)
			if not root or not root:IsA("BasePart") or not humanoid or not humanoid:IsA("Humanoid") then return end
			local deadline = os.clock() + 5
			while not stopped and player.Character == character and not character:GetAttribute("MidnightSpawnReady") and os.clock() < deadline do task.wait(0.05) end
			if stopped or player.Character ~= character or not character:GetAttribute("MidnightSpawnReady") then return end
			RunService.RenderStepped:Wait()
			if stopped or player.Character ~= character then return end
			local camera = workspace.CurrentCamera
			if not camera then return end
			local forward = Vector3.new(0, 0, 1)
			camera.CameraType, camera.CameraSubject = Enum.CameraType.Custom, humanoid
			-- 새 캐릭터마다 한 번만 초기 방향을 잡고 즉시 Roblox 기본 카메라에 조작을 돌려준다.
			camera.CFrame = CFrame.lookAt(root.Position - forward * 14 + Vector3.new(0, 7, 0), root.Position + forward * 12 + Vector3.new(0, 3, 0))
		end)
	end
	local connection = player.CharacterAdded:Connect(orient)
	if player.Character then orient(player.Character) end
	return function() stopped = true; connection:Disconnect() end
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local Steps=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("TutorialSteps"))
local Controller={}
function Controller.start(remote: RemoteEvent,settings)
	local step,done,manual,pending=1,false,false,false
	local state=nil
	local lastSent=-math.huge
	local gui=Instance.new("ScreenGui")
	gui.Name,gui.ResetOnSpawn,gui.DisplayOrder,gui.ScreenInsets="MidnightTutorial",false,30,Enum.ScreenInsets.CoreUISafeInsets
	gui.Parent=Players.LocalPlayer:WaitForChild("PlayerGui")
	local panel=Instance.new("Frame")
	panel.AnchorPoint,panel.Position,panel.Size=Vector2.new(0.5,0.5),UDim2.fromScale(0.5,0.45),UDim2.new(1,-24,0,218)
	panel.BackgroundColor3,panel.BorderSizePixel,panel.Visible,panel.Parent=Color3.fromRGB(17,25,44),0,false,gui
	local limit=Instance.new("UISizeConstraint");limit.MaxSize,limit.Parent=Vector2.new(480,218),panel
	local corner=Instance.new("UICorner");corner.Parent=panel
	local function label(position,size,font)
		local l=Instance.new("TextLabel")
		l.Position,l.Size,l.TextSize,l.BackgroundTransparency,l.TextColor3,l.TextWrapped,l.Parent=position,size,font,1,Color3.fromRGB(246,244,235),true,panel
		l.Font,l.TextXAlignment=Enum.Font.GothamMedium,Enum.TextXAlignment.Left
		return l
	end
	local title=label(UDim2.fromOffset(14,6),UDim2.new(1,-28,0,32),20)
	local body=label(UDim2.fromOffset(14,44),UDim2.new(1,-28,0,112),16)
	local function button(text,position,size,parent)
		local b=Instance.new("TextButton")
		b.Text,b.Position,b.Size,b.BackgroundColor3,b.TextColor3,b.Font,b.TextSize,b.Parent=text,position,size,Color3.fromRGB(255,170,69),Color3.fromRGB(17,25,44),Enum.Font.GothamMedium,16,parent
		local c=Instance.new("UICorner");c.Parent=b
		return b
	end
	local nextButton=button("다음",UDim2.new(1,-128,1,-54),UDim2.fromOffset(114,44),panel)
	local skip=button("안내 닫기",UDim2.new(0,14,1,-54),UDim2.fromOffset(114,44),panel)
	local replay=button("게임 방법 다시 보기",UDim2.new(),UDim2.fromOffset(180,44),gui)
	settings.register(replay)
	local function render()
		title.Text,body.Text=Steps[step].title,Steps[step].body
		nextButton.Text=if step==#Steps then "알겠어요"else"다음"
		panel.Visible=state~=nil and state.downUntil<=workspace:GetServerTimeNow() and not state.vehicle.seated
			and (manual or ((state.phase=="WAITING" or not state.participant) and state.data.mode~="LOADING" and not state.tutorialSeen and not done))
	end
	local function complete()
		done,manual,pending=true,false,true
		render()
		if state and state.data.mode~="LOADING"then remote:FireServer({kind="TutorialComplete",roundId=state.roundId});lastSent=os.clock()end
	end
	local connections={
		nextButton.Activated:Connect(function()if step<#Steps then step+=1;render()else complete()end end),
		skip.Activated:Connect(complete),
		replay.Activated:Connect(function()step,manual=1,true;render()end),
	}
	return {
		update=function(snapshot)
			state=snapshot
			if snapshot.tutorialSeen then pending=false end
			if pending and snapshot.data.mode~="LOADING"and os.clock()-lastSent>=1 then
				remote:FireServer({kind="TutorialComplete",roundId=snapshot.roundId});lastSent=os.clock()
			end
			render()
		end,
		destroy=function()for _,c in connections do c:Disconnect()end;replay:Destroy();gui:Destroy()end,
	}
end
return Controller
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="52">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
return table.freeze({
	Background = Color3.fromRGB(17, 25, 44), Panel = Color3.fromRGB(27, 39, 64),
	Text = Color3.fromRGB(246, 244, 235), Muted = Color3.fromRGB(178, 191, 212),
	Orange = Color3.fromRGB(255, 170, 69), Cyan = Color3.fromRGB(99, 216, 232),
})
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">UIFactory</string>
              <string name="Source"><![CDATA[--!strict
local Theme = require(script.Parent.Theme)
local Strings = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Strings"))
local Factory = {}

local function label(parent: Instance, name: string, text: string, position: UDim2, size: UDim2, fontSize: number, color: Color3?)
	local item = Instance.new("TextLabel")
	item.Name, item.Text, item.Position, item.Size = name, text, position, size
	item.BackgroundTransparency, item.TextColor3, item.TextSize = 1, color or Theme.Text, fontSize
	item.Font, item.TextWrapped = Enum.Font.GothamMedium, true
	item.TextXAlignment = Enum.TextXAlignment.Left
	item.Parent = parent
	return item
end

local function panel(parent: Instance, name: string, position: UDim2, size: UDim2)
	local item = Instance.new("Frame")
	item.Name, item.Position, item.Size = name, position, size
	item.BackgroundColor3, item.BackgroundTransparency, item.BorderSizePixel = Theme.Panel, 0.08, 0
	item.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius, corner.Parent = UDim.new(0, 14), item
	local stroke = Instance.new("UIStroke")
	stroke.Color, stroke.Transparency, stroke.Parent = Theme.Cyan, 0.65, item
	return item
end

function Factory.create(playerGui: Instance)
	local old = playerGui:FindFirstChild("MidnightHUD")
	if old then old:Destroy() end
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.ResetOnSpawn, gui.ZIndexBehavior = "MidnightHUD", false, Enum.ZIndexBehavior.Sibling
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	gui.Parent = playerGui
	local root = Instance.new("Frame")
	root.Name, root.Size, root.BackgroundTransparency, root.Parent = "SafeRoot", UDim2.fromScale(1, 1), 1, gui
	local header = panel(root, "Header", UDim2.new(0, 12, 0, 8), UDim2.new(1, -24, 0, 66))
	label(header, "Brand", Strings.Subtitle, UDim2.fromOffset(14, 6), UDim2.new(1, -150, 0, 20), 14, Theme.Orange)
	local phase = label(header, "Phase", "서버 연결 중…", UDim2.fromOffset(14, 28), UDim2.new(1, -150, 0, 30), 17)
	local timer = label(header, "Timer", "--:--", UDim2.new(0.75, 0, 0, 15), UDim2.new(0.25, -14, 0, 40), 25, Theme.Cyan)
	timer.AnchorPoint=Vector2.new(1,0)
	timer.Position,timer.Size=UDim2.new(1,-58,0,15),UDim2.fromOffset(76,40)
	timer.TextXAlignment = Enum.TextXAlignment.Right
	local card = panel(root, "Order", UDim2.fromOffset(12, 84), UDim2.fromOffset(300, 142))
	local title = label(card, "Title", Strings.Title, UDim2.fromOffset(12, 10), UDim2.new(1, -24, 0, 25), 18, Theme.Orange)
	local hint = label(card, "Hint", "주문 확인 → 길 따라 이동 → 현관 배달", UDim2.fromOffset(12, 42), UDim2.new(1, -24, 0, 76), 15)
	local toggle = Instance.new("TextButton")
	toggle.Text, toggle.Size, toggle.Position = "주문 접기", UDim2.fromOffset(100, 44), UDim2.new(1, -112, 0, 84)
	toggle.Font, toggle.TextSize, toggle.TextColor3 = Enum.Font.GothamMedium, 14, Theme.Text
	toggle.BackgroundColor3, toggle.Parent = Theme.Panel, root
	local corner = Instance.new("UICorner"); corner.Parent = toggle
	local stats = label(root, "Stats", "", UDim2.fromOffset(16, 234), UDim2.new(1, -140, 0, 44), 14, Theme.Orange)
	local note = label(root, "Note", Strings.SessionOnly, UDim2.fromOffset(16, 260), UDim2.new(1, -140, 0, 54), 12, Theme.Muted)
	local arrow = label(root, "Arrow", "▲", UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(44, 44), 32, Theme.Cyan)
	arrow.AnchorPoint, arrow.TextXAlignment = Vector2.new(0.5, 0.5), Enum.TextXAlignment.Center
	local distance = label(root, "Distance", "", UDim2.fromScale(0.5, 0.6), UDim2.fromOffset(210, 32), 14, Theme.Cyan)
	distance.AnchorPoint, distance.TextXAlignment = Vector2.new(0.5, 0), Enum.TextXAlignment.Center
	local recovery = label(root, "Recovery", "", UDim2.new(0.08, 0, 0.58, 0), UDim2.new(0.84, 0, 0, 80), 19, Theme.Orange)
	recovery.TextXAlignment = Enum.TextXAlignment.Center
	local team = label(root, "Team", "", UDim2.new(0, 16, 1, -65), UDim2.new(0.6, 0, 0, 50), 12, Theme.Muted)
	local toast = label(root, "Toast", "", UDim2.new(0.1, 0, 0.72, 0), UDim2.new(0.8, 0, 0, 48), 20, Theme.Orange)
	toast.TextXAlignment = Enum.TextXAlignment.Center
	return { gui = gui, root = root, phase = phase, timer = timer, card = card, title = title, hint = hint,
		toggle = toggle, stats = stats, note = note, arrow = arrow, distance = distance, toast = toast, recovery = recovery, team = team }
end

return Factory
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
