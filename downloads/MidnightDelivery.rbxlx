        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">ActionLimiter</string>
            <string name="Source"><![CDATA[--!strict
-- 하나의 플레이어가 Remote를 몰아서 보내도 엔진 작업량을 제한한다.
local Limiter = {}
Limiter.__index = Limiter
type Entry = { tokens: number, time: number }
type Store = { records: { [number]: Entry } }
export type Model = typeof(setmetatable({} :: Store, Limiter))
function Limiter.new(): Model return setmetatable({ records = {} }, Limiter) end
function Limiter.allow(self: Model, id: number, now: number): boolean
	local entry = self.records[id]
	if not entry then entry = { tokens = 20, time = now }; self.records[id] = entry end
	entry.tokens = math.min(20, entry.tokens + math.max(0, now - entry.time) * 15)
	entry.time = now
	if entry.tokens < 1 then return false end
	entry.tokens -= 1
	return true
end
function Limiter.remove(self: Model, id: number) self.records[id] = nil end
return Limiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">CosmeticService</string>
            <string name="Source"><![CDATA[--!strict
local P = require(script.Parent.Parent.World.Primitives)
local Service={}
Service.__index=Service
function Service.new(data,vehicles) return setmetatable({data=data,vehicles=vehicles,bindings={},cache={},stopped=false},Service) end
function Service:apply(player)
	local profile=self.data:profile(player)
	local equipped=if profile then profile.equipped else {}
	self.vehicles:skin(player,equipped.scooter or "")
	local char=player.Character
	local head=char and char:FindFirstChild("Head")
	if not char or not head or not head:IsA("BasePart") then return end
	local signature=(equipped.hat or "")..":"..(equipped.scooter or "")..":"..(equipped.badge or "")
	local cached=self.cache[player]
	if cached and cached.character==char and cached.signature==signature then return end
	self.cache[player]={character=char,signature=signature}
	local previous=char:FindFirstChild("MidnightCosmetics")
	if previous then previous:Destroy() end
	local model=Instance.new("Model")
	model.Name,model.Parent="MidnightCosmetics",char
	local function part(name,size,frame,color,target,material)
		local body=P.part(model,name,size,frame,color,material)
		body.Anchored,body.Massless,body.CanCollide,body.CanTouch,body.CanQuery=false,true,false,false,false
		local weld=Instance.new("WeldConstraint")
		weld.Part0,weld.Part1,weld.Parent=target,body,body
		return body
	end
	if equipped.hat=="neon_cap" then
		local color=Color3.fromRGB(255,170,69)
		part("Cap",Vector3.new(head.Size.X+0.3,0.5,head.Size.Z+0.2),head.CFrame*CFrame.new(0,head.Size.Y/2+0.2,0),color,head)
		part("NeonBrim",Vector3.new(head.Size.X+0.5,0.12,1),head.CFrame*CFrame.new(0,head.Size.Y/2,-0.8),color,head,Enum.Material.Neon)
	end
	if equipped.badge=="ghost_badge" then
		local torso=char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
		if torso and torso:IsA("BasePart") then
			local body=part("GhostBadge",Vector3.new(0.65,0.8,0.25),torso.CFrame*CFrame.new(-0.5,0.2,-torso.Size.Z/2-0.2),Color3.fromRGB(170,139,255),torso,Enum.Material.Neon)
			body.Shape=Enum.PartType.Ball
			for _,x in {-0.64,-0.36} do
				part("BadgeEye",Vector3.new(0.1,0.15,0.08),torso.CFrame*CFrame.new(x,0.32,-torso.Size.Z/2-0.35),Color3.fromRGB(27,39,64),torso)
			end
		end
	end
end
function Service:add(player)
	self.bindings[player]=player.CharacterAdded:Connect(function(char)
		task.spawn(function()
			char:WaitForChild("Head",10)
			if not self.stopped and self.bindings[player] and player.Character==char then self:apply(player) end
		end)
	end)
	self:apply(player)
end
function Service:remove(player) self.cache[player]=nil;if self.bindings[player] then self.bindings[player]:Disconnect();self.bindings[player]=nil end end
function Service:destroy() self.stopped=true;for player in self.bindings do self:remove(player) end end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
local Model = require(script.Parent.ProfileModel)
local ProfileStore = require(script.Parent.ProfileStore)
local Service = {}
Service.__index = Service
function Service.new(economy, changed)
	local DataStores = game:GetService("DataStoreService")
	local Http = game:GetService("HttpService")
	local Run = game:GetService("RunService")
	local name = if Run:IsStudio() then "MidnightDelivery_Studio_PlayerData_v1" else "MidnightDelivery_Live_PlayerData_v1"
	local adapter = nil
	if game.GameId ~= 0 then
		local ok,value = pcall(function() return DataStores:GetDataStore(name) end)
		if ok then adapter=value end
	end
	print("[MidnightDelivery] Data namespace=" .. name .. (if adapter then "" else " (session only; unpublished/unavailable)"))
	return setmetatable({economy=economy,changed=changed,adapter=adapter,http=Http,handles={},stopped=false},Service)
end
function Service:sync(player, handle)
	if self.handles[player] ~= handle or handle.closing then return end
	player:SetAttribute("Coins",handle.profile.coins)
	player:SetAttribute("XP",handle.profile.xp)
	player:SetAttribute("Level",Model.level(handle.profile.xp))
	self.changed(player)
end
function Service:begin(player)
	local placeholder = {profile=Model.default(),mode="LOADING",reason="",expiresAt=0,version=0,dirty=false,busy=false,closing=false,loading=true}
	self.handles[player]=placeholder
	self.economy.profiles[player.UserId]=placeholder.profile
	self:sync(player,placeholder)
	task.spawn(function()
		local store = if self.adapter then ProfileStore.new(self.adapter,os.time,task.wait,self.http:GenerateGUID(false)) else nil
		placeholder.store=store
		local loaded = if store then store:load(player.UserId) else {profile=Model.default(),mode="SESSION",reason="unpublished_or_unavailable",expiresAt=0,version=0,dirty=false,busy=false}
		-- 퇴장 중 로드가 끝나도 새 Player의 메모리 프로필을 덮지 않는다.
		for _,key in {"profile","mode","reason","expiresAt","version","dirty","busy"} do placeholder[key]=loaded[key] end
		placeholder.loading=false
		if loaded.mode=="SESSION" then warn("[MidnightDelivery] Profile session-only: user="..player.UserId.." reason="..tostring(loaded.reason)) end
		placeholder.nextSave=os.clock()+60+(player.UserId%15)
		if placeholder.closing or self.stopped then self:close(player,placeholder);return end
		if self.handles[player]~=placeholder then return end
		self.economy.profiles[player.UserId]=placeholder.profile
		self:sync(player,placeholder)
	end)
end
function Service:loaded(player): boolean
	local h=self.handles[player]
	return h~=nil and not h.loading and not h.closing
end
function Service:canEarn(player): boolean
	local h=self.handles[player]
	if not h or h.loading or h.closing then return false end
	if h.store then h.store:writable(h) end
	return true
end
function Service:canShop(player): boolean
	local h=self.handles[player]
	return h~=nil and h.store~=nil and h.mode=="READY" and h.store:writable(h) and not h.closing
end
function Service:profile(player)
	local h=self.handles[player]
	return if h then h.profile else nil
end
function Service:status(player)
	local h=self.handles[player]
	if not h then return {mode="LOADING",reason="",dirty=false} end
	return {mode=if h.busy then "SAVING" else h.mode,reason=h.reason,dirty=h.dirty}
end
function Service:touch(player)
	local h=self.handles[player]
	if not h or h.closing then return end
	h.version+=1
	if h.mode=="READY" or h.mode=="SAVE_ERROR" then h.dirty=true end
	self:sync(player,h)
end
function Service:preference(player,key,value): boolean
	if not self:canEarn(player) then return false end
	local profile=self:profile(player)
	if not profile then return false end
	if key=="tutorialSeen" then
		if value~=true then return false end
		profile.tutorialSeen=true
	elseif Model.preference(key,value) then profile.preferences[key]=value
	else return false end
	self:touch(player);self:queueSave(player)
	return true
end
function Service:queueSave(player)
	local h=self.handles[player]
	if h then h.nextSave=math.min(h.nextSave or math.huge,os.clock()+5) end
end
function Service:tick()
	for player,h in self.handles do
		if not h.loading and not h.closing and h.store and not h.busy and os.clock()>=(h.nextSave or math.huge)
			and (h.mode=="READY" or h.mode=="SAVE_ERROR") then
			h.nextSave=os.clock()+60+(player.UserId%15)
			task.spawn(function()
				local ok=h.store:save(player.UserId,h,false)
				if not ok then warn("[MidnightDelivery] Profile save not confirmed: user="..player.UserId.." reason="..h.reason) end
				self:sync(player,h)
			end)
		end
	end
end
function Service:close(player,h)
	if h.closeBusy or h.closed then return end
	h.closeBusy,h.closing=true,true
	local deadline=os.clock()+25
	while (h.loading or h.busy) and os.clock()<deadline do task.wait(0.1) end
	local neededSave=h.loading or h.mode=="READY" or h.mode=="SAVE_ERROR"
	local ok=h.mode=="SESSION"
	if not h.loading and not h.busy and h.store then ok=h.store:save(player.UserId,h,true) end
	if not ok and neededSave then warn("[MidnightDelivery] Closing profile not confirmed; user="..player.UserId) end
	h.closeBusy,h.closed=false,true
	-- 로드 요청이 25초 뒤에 끝나면 begin의 닫기 경로가 임대 해제를 다시 시도한다.
	if h.loading then h.closed=false;return end
	if self.handles[player]==h then self.handles[player]=nil end
end
function Service:remove(player)
	local h=self.handles[player]
	if h then h.closing=true;task.spawn(function()self:close(player,h)end) end
end
function Service:shutdown()
	self.stopped=true
	for player,h in self.handles do h.closing=true;task.spawn(function()self:close(player,h)end) end
	local deadline=os.clock()+25
	while next(self.handles) and os.clock()<deadline do task.wait(0.1) end
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict
-- 지갑은 DataService와 메모리 객체를 공유한다. 지급은 비동기 저장 콜백 밖에서 한 번만 실행한다.
local Economy = {}
Economy.__index = Economy
type Profile = { coins: number, xp: number, lifetimeDeliveries: number? }
type State = { profiles: { [number]: Profile }, paid: { [string]: boolean }, roundId: number, canMutate: ((any) -> boolean)?, onMutation: ((any) -> ())? }
type Service = typeof(setmetatable({} :: State, Economy))

function Economy.new(): Service
	return setmetatable({ profiles = {}, paid = {}, roundId = 0 }, Economy)
end

function Economy.add(self: Service, player: any)
	if not self.profiles[player.UserId] then self.profiles[player.UserId] = { coins = 0, xp = 0 } end
	local profile = self.profiles[player.UserId]
	player:SetAttribute("Coins", profile.coins)
	player:SetAttribute("XP", profile.xp)
end

function Economy.remove(self: Service, player: any)
	-- 퇴장 기록을 무한히 쌓지 않는다. 현재 주문의 paid 키는 라운드 종료까지 유지한다.
	self.profiles[player.UserId] = nil
end

function Economy.award(self: Service, player: any, roundId: number, coins: number, xp: number, orderId: number?): boolean
	if self.canMutate and not self.canMutate(player) then return false end
	if roundId < self.roundId then return false end
	if roundId > self.roundId then self.roundId = roundId; table.clear(self.paid) end
	local id = player.UserId
	local key = tostring(orderId or 1) .. ":" .. tostring(id)
	if self.paid[key] or not self.profiles[id] then return false end
	self.paid[key] = true
	local profile = self.profiles[id]
	profile.coins = math.min(1000000000,profile.coins + coins)
	profile.xp = math.min(1000000000,profile.xp + xp)
	if (orderId or 1) <= 3 then profile.lifetimeDeliveries = math.min(1000000000,(profile.lifetimeDeliveries or 0)+1) end
	player:SetAttribute("Coins", profile.coins)
	player:SetAttribute("XP", profile.xp)
	if self.onMutation then self.onMutation(player) end
	return true
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">MonsterService</string>
            <string name="Source"><![CDATA[--!strict
local Pathfinding = game:GetService("PathfindingService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
local Factory = require(script.Parent.Parent.World.MonsterFactory)
local Service = {}
Service.__index = Service
type Actor = { model: Model, root: Part, humanoid: Humanoid }
type Chase = { kind: string, target: Player, character: Model?, actor: Actor, endsAt: number,
	nextPathAt: number, busy: boolean, waypoints: { PathWaypoint }, waypoint: number }
type StateAccess = { canChase: (any, Player) -> boolean, root: (any, Player) -> (BasePart?, Humanoid?), down: (any, Player) -> boolean }
type Store = { parent: Instance, states: StateAccess, changed: () -> (), active: Chase? }
export type Runtime = typeof(setmetatable({} :: Store, Service))
function Service.new(parent: Instance, states: StateAccess, changed: () -> ()): Runtime
	return setmetatable({ parent = parent, states = states, changed = changed, active = nil }, Service)
end
function Service.stop(self: Runtime)
	if not self.active then return end
	local active = self.active
	self.active = nil
	active.actor.model:Destroy()
	self.changed()
end
function Service.status(self: Runtime)
	local active = self.active
	return { kind = if active then active.kind else "", targetId = if active then active.target.UserId else 0,
		endsAt = if active then active.endsAt else 0 }
end
function Service.start(self: Runtime, kind: string, target: Player?, origin: Vector3)
	if not target or not self.states:canChase(target) then return end
	self:stop()
	local duration = if kind == "Ghost" then Config.Monster.GhostDuration elseif kind == "Giant" then Config.Monster.GiantDuration else Config.Monster.FakeDuration
	local groundRay = RaycastParams.new()
	groundRay.FilterType, groundRay.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude, { self.parent, target.Character }
	-- 현관 바깥에서 지면을 찾고 생성한다. 집 내부/지붕 위 스폰을 피한다.
	local hit = workspace:Raycast(origin + Vector3.new(0, 25, 0), Vector3.new(0, -80, 0), groundRay)
	local spawnPosition = if hit then hit.Position + Vector3.new(0, 7, 0) else origin + Vector3.new(0, 7, 0)
	local actor = Factory.create(self.parent, kind, spawnPosition)
	actor.root:SetNetworkOwner(nil)
	self.active = { kind = kind, target = target, character = target.Character, actor = actor,
		endsAt = workspace:GetServerTimeNow() + duration, nextPathAt = 0, busy = false, waypoints = {}, waypoint = 1 }
	self.changed()
end
function Service.tick(self: Runtime)
	local active = self.active
	if not active then return end
	local timestamp = workspace:GetServerTimeNow()
	local targetRoot = self.states:root(active.target)
	if timestamp >= active.endsAt or active.target.Character ~= active.character or not self.states:canChase(active.target)
		or not targetRoot or not active.actor.model.Parent or active.actor.humanoid.Health <= 0 or active.actor.root.Position.Y < -50 then self:stop(); return end
	local actor = active.actor
	local delta = targetRoot.Position - actor.root.Position
	-- 서버 근접 판정 + 시야 검사. 벽 뒤 플레이어를 거리만으로 기절시키지 않는다.
	if delta.Magnitude <= Config.Monster.CatchDistance then
		local ray = RaycastParams.new()
		ray.FilterType, ray.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude, { actor.model }
		local hit = workspace:Raycast(actor.root.Position, delta, ray)
		if not hit or (active.character and hit.Instance:IsDescendantOf(active.character)) then
			self.states:down(active.target)
			self:stop()
			return
		end
	end
	if timestamp >= active.nextPathAt and not active.busy then
		active.busy, active.nextPathAt = true, timestamp + Config.Monster.PathInterval
		local startPosition, goal = actor.root.Position, targetRoot.Position
		task.spawn(function()
			local ok, waypoints = pcall(function()
				local path = Pathfinding:CreatePath({ AgentRadius = if active.kind == "Giant" then 3.5 else 2.5, AgentHeight = 9, AgentCanJump = true })
				path:ComputeAsync(startPosition, goal)
				return if path.Status == Enum.PathStatus.Success then path:GetWaypoints() else {}
			end)
			-- 취소된 ComputeAsync가 늦게 돌아와 새 추격의 상태를 덮어쓰지 않게 한다.
			if self.active ~= active then return end
			active.busy = false
			active.waypoints = if ok then waypoints else {}
			active.waypoint = 2
		end)
	end
	local waypoint = active.waypoints[active.waypoint]
	if waypoint and (actor.root.Position - waypoint.Position).Magnitude < 4 then
		active.waypoint += 1; waypoint = active.waypoints[active.waypoint]
	end
	if waypoint then
		if waypoint.Action == Enum.PathWaypointAction.Jump then actor.humanoid.Jump = true end
		actor.humanoid:MoveTo(waypoint.Position)
	else
		-- 경로 실패 시 물리 충돌을 유지한 MoveTo 폴백. CFrame 순간이동으로 벽을 뚫지 않는다.
		actor.humanoid:MoveTo(targetRoot.Position)
	end
end
function Service.destroy(self: Runtime) self:stop() end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">MovementModel</string>
            <string name="Source"><![CDATA[--!strict
-- 스프린트와 차량 수치는 순수 함수로 검사한다. 클라이언트 속도 주장은 받지 않는다.
local Model = {}
export type Stamina = { value: number, exhausted: boolean }
function Model.stamina(state: Stamina, wants: boolean, moving: boolean, enabled: boolean, dt: number): number
	dt = math.clamp(dt, 0, 0.2)
	local running = wants and moving and enabled and not state.exhausted and state.value > 0
	state.value = math.clamp(state.value + (if running then -dt else dt), 0, 5)
	if state.value <= 0.001 then state.exhausted = true end
	if state.value >= 4.999 then state.exhausted = false end
	return if running then 22 else 16
end
function Model.speed(speed: number, throttle: number, dt: number, maximum: number?): number
	local target = if throttle >= 0 then throttle * (maximum or 38) else throttle * 12
	local rate = if throttle == 0 then 26 else 18
	return speed + math.clamp(target - speed, -rate * dt, rate * dt)
end
function Model.input(throttle: any, steer: any): boolean
	return typeof(throttle) == "number" and typeof(steer) == "number" and throttle == throttle and steer == steer
		and math.abs(throttle) <= 1 and math.abs(steer) <= 1
end
return Model
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">OrderModel</string>
            <string name="Source"><![CDATA[--!strict
-- 순수 주문 규칙. 위치/방향/홀드 시간은 엔진 연결층이 서버에서 검증해 전달한다.
local Order = {}
Order.__index = Order
export type Spec = { kind: string, destination: string, title: string, hint: string }
export type Outcome = { success: boolean, reward: number, reason: string, index: number }
type Settings = { Duration: number, GhostHold: number, GhostCooldown: number, GiantHot: number, GiantCalm: number, FakeLock: number }
type State = {
	settings: Settings, specs: { Spec }, index: number, expiresAt: number, stage: string,
	startedAt: number, cooldownUntil: number, knocks: number, lastKnock: number,
	holdUntil: number, holder: number?, attempts: number, mistakes: number, late: boolean,
	pending: Outcome?, successes: number, failures: number,
}
export type Model = typeof(setmetatable({} :: State, Order))

function Order.new(settings: Settings, specs: { Spec }): Model
	return setmetatable({ settings = settings, specs = specs, index = 0, expiresAt = 0, stage = "IDLE",
		startedAt = 0, cooldownUntil = 0, knocks = 0, lastKnock = -math.huge, holdUntil = 0,
		holder = nil, attempts = 0, mistakes = 0, late = false, pending = nil, successes = 0, failures = 0 }, Order)
end
function Order.current(self: Model): Spec?
	return self.specs[self.index]
end
function Order.advance(self: Model, now: number): boolean
	if self.index >= #self.specs then self.stage = "DONE"; return false end
	self.index += 1
	self.stage, self.startedAt, self.expiresAt = "ACTIVE", now, now + self.settings.Duration
	self.cooldownUntil, self.knocks, self.lastKnock = 0, 0, -math.huge
	self.holdUntil, self.holder, self.attempts, self.mistakes, self.late = 0, nil, 0, 0, false
	return true
end
function Order.resolve(self: Model, success: boolean, reward: number, reason: string)
	if self.stage == "RESOLVED" or self.stage == "DONE" or self.stage == "IDLE" then return end
	self.stage = "RESOLVED"
	if success then self.successes += 1 else self.failures += 1 end
	self.pending = { success = success, reward = reward, reason = reason, index = self.index }
end
function Order.takeOutcome(self: Model): Outcome?
	local result = self.pending
	self.pending = nil
	return result
end
function Order.tick(self: Model, now: number, holderValid: boolean): boolean
	local spec = self:current()
	if not spec or self.stage == "RESOLVED" or self.stage == "DONE" then return false end
	if now >= self.expiresAt then self:resolve(false, 0, "주문 시간 초과"); return true end
	if self.stage == "COOLDOWN" and now >= self.cooldownUntil then self.stage = "ACTIVE"; return true end
	if spec.kind == "Giant" and not self.late and now >= self.startedAt + self.settings.GiantHot then
		self.late, self.stage = true, "CALM"
		return true
	end
	if self.stage == "HOLDING" then
		if not holderValid then
			self.attempts += 1
			self.knocks, self.holder = 0, nil
			if self.attempts >= 3 then self:resolve(false, 0, "유령 규칙 3회 위반")
			else self.stage, self.cooldownUntil = "COOLDOWN", now + self.settings.GhostCooldown end
			return true
		elseif now >= self.holdUntil then self:resolve(true, 80, "유령 배달 성공"); return true end
	end
	return false
end
function Order.interact(self: Model, destination: string, userId: number, now: number, heldFor: number): boolean
	local spec = self:current()
	if not spec or now >= self.expiresAt or (self.stage ~= "ACTIVE" and self.stage ~= "CALM") then return false end
	if spec.kind == "Fake" then
		if not string.match(destination, "^fake_[123]$") then return false end
		if destination == spec.destination then self:resolve(true, 80, "진짜 주소를 찾았습니다")
		else
			self.mistakes += 1
			if self.mistakes >= 2 then self:resolve(false, 0, "가짜 집 2회 오배송")
			else self.stage, self.cooldownUntil = "COOLDOWN", now + self.settings.FakeLock end
		end
	elseif destination ~= spec.destination then return false
	elseif spec.kind == "Ghost" then
		if now - self.lastKnock < 0.6 then return false end
		self.lastKnock, self.knocks = now, self.knocks + 1
		if self.knocks == 3 then
			self.stage, self.holder, self.holdUntil = "HOLDING", userId, now + self.settings.GhostHold
		end
	elseif spec.kind == "Giant" then
		-- 90초 경계에서 Heartbeat보다 프롬프트가 먼저 도착해도 할인 규칙이 적용된다.
		local isLate = self.late or now >= self.startedAt + self.settings.GiantHot
		if isLate and heldFor < self.settings.GiantCalm then return false end
		self.late = isLate
		self:resolve(true, if self.late then 56 else 80, if self.late then "거인 진정 성공 · 식은 음식" else "따뜻한 음식 배달 성공")
	else return false end
	return true
end
return Order
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">OrderPlanner</string>
            <string name="Source"><![CDATA[--!strict
local Planner = {}
function Planner.create(roundId: number, candidates)
	local chosen = candidates[(roundId - 1) % #candidates + 1]
	local specs = {
		{ kind = "Ghost", destination = "ghost_house", title = "유령 · 01 파란 지붕집", hint = "문을 3번 두드린 뒤 4초 동안 문을 향하세요.\n카메라 대신 캐릭터 방향을 검사합니다." },
		{ kind = "Giant", destination = "giant_house", title = "거인 · 02 큰 현관집", hint = "90초 안에 따뜻하게 배달하세요.\n늦으면 현관에서 3초간 진정시키기 · 보상 56 Coins" },
		{ kind = "Fake", destination = chosen.id, title = "수상한 주소 · 외곽 주택 03", hint = "단서: " .. chosen.clue .. "\n잘못된 집은 10초 대기 · 2회 실수 시 실패" },
	}
	-- 첫 판은 학습 순서, 다음 판부터 시작 고객과 단서가 바뀐다. 세 종류는 매번 모두 등장한다.
	local result = {}
	for offset = 0, 2 do table.insert(result, specs[(roundId - 1 + offset) % 3 + 1]) end
	return result
end
return Planner
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">PlayerStateModel</string>
            <string name="Source"><![CDATA[--!strict
-- 기절/복귀는 단조 시각과 세대 번호로 관리하여 구조·자동 복귀 경합을 한 번만 처리한다.
local State = {}
State.__index = State
export type Entry = { downUntil: number, protectedUntil: number, generation: number }
type Store = { entries: { [number]: Entry }, duration: number, protection: number }
export type Model = typeof(setmetatable({} :: Store, State))
function State.new(duration: number, protection: number): Model
	return setmetatable({ entries = {}, duration = duration, protection = protection }, State)
end
function State.reset(self: Model, id: number, now: number)
	local previous = self.entries[id]
	self.entries[id] = { downUntil = 0, protectedUntil = now + self.protection, generation = if previous then previous.generation + 1 else 1 }
end
function State.remove(self: Model, id: number) self.entries[id] = nil end
function State.canAct(self: Model, id: number): boolean
	local entry = self.entries[id]
	return entry ~= nil and entry.downUntil == 0
end
function State.down(self: Model, id: number, now: number): boolean
	local entry = self.entries[id]
	if not entry or entry.downUntil ~= 0 or now < entry.protectedUntil then return false end
	entry.downUntil = now + self.duration
	entry.generation += 1
	return true
end
function State.recover(self: Model, id: number, generation: number, now: number): boolean
	local entry = self.entries[id]
	if not entry or entry.downUntil == 0 or entry.generation ~= generation then return false end
	entry.downUntil, entry.protectedUntil = 0, now + self.protection
	entry.generation += 1
	return true
end
return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">PlayerStateService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
local StateModel = require(script.Parent.PlayerStateModel)
local Service = {}
Service.__index = Service
type Downed = {
	root: BasePart, humanoid: Humanoid, character: Model, attachment: Attachment, generation: number,
	anchored: boolean, walkSpeed: number, jumpPower: number, jumpHeight: number, autoRotate: boolean,
	connections: { RBXScriptConnection },
}
type Rescue = { victim: Player, generation: number, character: Model?, began: number, endedAt: number? }
type Store = { spawn: SpawnLocation, isParticipant: (Player) -> boolean, changed: () -> (), model: StateModel.Model,
	bindings: { [Player]: RBXScriptConnection }, downed: { [Player]: Downed }, rescuers: { [Player]: Rescue }, stopped: boolean, authorizedMove: ((Player) -> ())?, beforeDown: ((Player) -> ())? }
export type Runtime = typeof(setmetatable({} :: Store, Service))

function Service.new(spawn: SpawnLocation, isParticipant: (Player) -> boolean, changed: () -> (), authorizedMove: ((Player) -> ())?): Runtime
	return setmetatable({ spawn = spawn, isParticipant = isParticipant, changed = changed,
		model = StateModel.new(Config.Recovery.DownTime, Config.Recovery.Protection),
		authorizedMove = authorizedMove, bindings = {}, downed = {}, rescuers = {}, stopped = false }, Service)
end
function Service.now(self: Runtime) return workspace:GetServerTimeNow() end
function Service.root(self: Runtime, player: Player): (BasePart?, Humanoid?)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then return nil, nil end
	local position = root.Position
	if position.X ~= position.X or position.Y ~= position.Y or position.Z ~= position.Z
		or math.abs(position.X) > 1e6 or math.abs(position.Y) > 1e6 or math.abs(position.Z) > 1e6 then return nil, nil end
	return root, humanoid
end
function Service.canAct(self: Runtime, player: Player): boolean
	return self.model:canAct(player.UserId) and self:root(player) ~= nil
end
function Service.canChase(self: Runtime, player: Player): boolean
	local entry = self.model.entries[player.UserId]
	return self.isParticipant(player) and self:canAct(player) and entry ~= nil and self:now() >= entry.protectedUntil
end
function Service.status(self: Runtime, player: Player)
	local entry = self.model.entries[player.UserId]
	return { downUntil = if entry then entry.downUntil else 0, protectedUntil = if entry then entry.protectedUntil else 0 }
end
function Service.clearRecord(self: Runtime, player: Player)
	local record = self.downed[player]
	if not record then return end
	for _, connection in record.connections do connection:Disconnect() end
	record.attachment:Destroy()
	if record.root.Parent then record.root.Anchored = record.anchored end
	if record.humanoid.Parent then
		record.humanoid.WalkSpeed, record.humanoid.JumpPower = record.walkSpeed, record.jumpPower
		record.humanoid.JumpHeight, record.humanoid.AutoRotate = record.jumpHeight, record.autoRotate
	end
	self.downed[player] = nil
	for helper, hold in self.rescuers do if helper == player or hold.victim == player then self.rescuers[helper] = nil end end
end
function Service.spawnCharacter(self: Runtime, player: Player, character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if self.stopped or not self.bindings[player] or player.Character ~= character or not root or not root:IsA("BasePart") or not humanoid or not humanoid:IsA("Humanoid") then return end
	self:clearRecord(player)
	self.model:reset(player.UserId, self:now())
	-- SpawnLocation도 캐릭터 Pivot도 같은 도로 방향(+Z)을 사용한다.
	character:PivotTo(self.spawn.CFrame + Vector3.new((player.UserId % 4 - 1.5) * 3, 4, 0))
	character:SetAttribute("MidnightSpawnReady", true)
	self.changed()
end
function Service.add(self: Runtime, player: Player)
	self.model:reset(player.UserId, self:now())
	player.RespawnLocation = self.spawn
	self.bindings[player] = player.CharacterAdded:Connect(function(character)
		task.spawn(function() self:spawnCharacter(player, character) end)
	end)
	local character = player.Character
	if character then task.spawn(function() self:spawnCharacter(player, character) end) end
end
function Service.remove(self: Runtime, player: Player)
	if self.bindings[player] then self.bindings[player]:Disconnect(); self.bindings[player] = nil end
	self:clearRecord(player)
	self.rescuers[player] = nil
	self.model:remove(player.UserId)
end
function Service.validRescue(self: Runtime, helper: Player, victim: Player): boolean
	if helper == victim or not self.isParticipant(helper) or not self.isParticipant(victim) or not self:canAct(helper) then return false end
	local record = self.downed[victim]
	local helperRoot = self:root(helper)
	if not record or not helperRoot or victim.Character ~= record.character or record.humanoid.Health <= 0 then return false end
	local delta = record.root.Position - helperRoot.Position
	if delta.Magnitude ~= delta.Magnitude or delta.Magnitude > Config.Recovery.RescueDistance then return false end
	local ray = RaycastParams.new()
	ray.FilterType, ray.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude, { helper.Character, victim.Character }
	return workspace:Raycast(helperRoot.Position, delta, ray) == nil
end
function Service.recover(self: Runtime, player: Player, automatic: boolean): boolean
	local record = self.downed[player]
	if not record or not self.model:recover(player.UserId, record.generation, self:now()) then return false end
	if automatic and player.Character == record.character then
		-- 구조받지 못해도 가장 가까운 도로 체크포인트에서 복귀한다.
		local nearest, distance = Config.Recovery.Checkpoints[1], math.huge
		for _, point in Config.Recovery.Checkpoints do
			local d = (record.root.Position - point).Magnitude
			if d < distance then nearest, distance = point, d end
		end
		record.character:PivotTo(CFrame.new(nearest) * CFrame.Angles(0, math.pi, 0))
		record.root.AssemblyLinearVelocity, record.root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
	end
	self:clearRecord(player)
	if automatic and self.authorizedMove then self.authorizedMove(player) end
	self.changed()
	return true
end
function Service.down(self: Runtime, player: Player): boolean
	local root, humanoid = self:root(player)
	local character = player.Character
	if not character or not root or not humanoid or not self.isParticipant(player) or not self.model:down(player.UserId, self:now()) then return false end
	if self.beforeDown then self.beforeDown(player) end
	local attachment = Instance.new("Attachment")
	attachment.Name, attachment.Parent = "MidnightRescue", root
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText, prompt.ObjectText = "팀원 구조", player.DisplayName
	prompt.HoldDuration, prompt.MaxActivationDistance = Config.Recovery.RescueHold, Config.Recovery.RescueDistance
	prompt.RequiresLineOfSight, prompt.Parent = true, attachment
	local record: Downed = { root = root, humanoid = humanoid, character = character, attachment = attachment,
		generation = self.model.entries[player.UserId].generation, anchored = root.Anchored,
		walkSpeed = humanoid.WalkSpeed, jumpPower = humanoid.JumpPower, jumpHeight = humanoid.JumpHeight,
		autoRotate = humanoid.AutoRotate, connections = {} }
	self.downed[player] = record
	humanoid.Sit, humanoid.WalkSpeed, humanoid.JumpPower, humanoid.JumpHeight, humanoid.AutoRotate = false, 0, 0, 0, false
	root.Anchored = true
	table.insert(record.connections, prompt.PromptButtonHoldBegan:Connect(function(helper)
		if self:validRescue(helper, player) then
			self.rescuers[helper] = { victim = player, generation = record.generation, character = helper.Character, began = self:now() }
		end
	end))
	table.insert(record.connections, prompt.PromptButtonHoldEnded:Connect(function(helper)
		-- Triggered와 같은 틱에 종료될 수 있어 지연 후 시각을 확인한다.
		local hold = self.rescuers[helper]
		if hold and hold.victim == player then hold.endedAt = self:now() end
	end))
	table.insert(record.connections, prompt.Triggered:Connect(function(helper)
		local hold = self.rescuers[helper]
		if not hold or hold.victim ~= player or hold.generation ~= record.generation or hold.character ~= helper.Character then return end
		if hold.endedAt and self:now() - hold.endedAt > 0.2 then return end
		local endTime = hold.endedAt or self:now()
		if endTime - hold.began < Config.Recovery.RescueHold - 0.15 or not self:validRescue(helper, player) then return end
		local entry = self.model.entries[player.UserId]
		if entry and self:now() < entry.downUntil then self:recover(player, false) end
		self.rescuers[helper] = nil
	end))
	self.changed()
	return true
end
function Service.tick(self: Runtime)
	local timestamp = self:now()
	for helper, hold in self.rescuers do
		if hold.character ~= helper.Character or not self:validRescue(helper, hold.victim)
			or (hold.endedAt and timestamp - hold.endedAt > 0.2) then self.rescuers[helper] = nil end
	end
	for player in self.bindings do
		local root, humanoid = self:root(player)
		if root and humanoid and not humanoid.SeatPart and not self.downed[player]
			and (root.Position.Y < -20 or math.abs(root.Position.X) > 320 or math.abs(root.Position.Z) > 320) then
			player.Character:PivotTo(self.spawn.CFrame + Vector3.new(0,4,0))
			root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
			self.model:reset(player.UserId, timestamp)
			if self.authorizedMove then self.authorizedMove(player) end
			self.changed()
		end
	end
	local pending = {}
	for player, record in self.downed do
		local entry = self.model.entries[player.UserId]
		if not entry or player.Character ~= record.character or record.humanoid.Health <= 0 then table.insert(pending, {player = player, automatic = false})
		elseif timestamp >= entry.downUntil then table.insert(pending, {player = player, automatic = true}) end
	end
	for _, item in pending do
		if item.automatic then self:recover(item.player, true)
		else self:clearRecord(item.player); self.model:reset(item.player.UserId, timestamp); self.changed() end
	end
end
function Service.clearRound(self: Runtime)
	local pending = {}; for player in self.downed do table.insert(pending, player) end
	for _, player in pending do self:recover(player, true) end
	table.clear(self.rescuers)
end
function Service.destroy(self: Runtime)
	self.stopped = true
	local pending = {}; for player in self.bindings do table.insert(pending, player) end
	for _, player in pending do self:remove(player) end
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">ProfileModel</string>
            <string name="Source"><![CDATA[--!strict
-- 데이터 파싱/잠금/상점은 순수 함수로 분리한다. UpdateAsync 재호출에서 보상/구매를 실행하지 않는다.
local Model = {}
local MAX = 1000000000
local thresholds = { 0, 100, 250, 450, 700, 1000, 1400, 1900, 2500, 3200 }
export type Profile = { schemaVersion: number, coins: number, xp: number, lifetimeDeliveries: number,
	owned: { [string]: boolean }, equipped: { [string]: string },
	preferences: { muted: boolean, reducedMotion: boolean, largeText: boolean, hudMode: string }, tutorialSeen: boolean }
export type Row = { schemaVersion: number, profile: Profile, revision: number, updatedAt: number,
	lease: { token: string, expiresAt: number }? }
function Model.defaultPreferences()
	return {muted=false,reducedMotion=false,largeText=false,hudMode="auto"}
end
function Model.preference(key: any, value: any): boolean
	if key=="hudMode" then return value=="auto" or value=="compact" or value=="expanded" end
	return (key=="muted" or key=="reducedMotion" or key=="largeText") and typeof(value)=="boolean"
end
function Model.default(): Profile
	return { schemaVersion = 2, coins = 0, xp = 0, lifetimeDeliveries = 0, owned = {}, equipped = {hat="",scooter="",badge=""}, preferences=Model.defaultPreferences(), tutorialSeen=false }
end
function Model.integer(value: any, maximum: number?): boolean
	return typeof(value) == "number" and value == value and value >= 0 and value <= (maximum or MAX) and value % 1 == 0
end
function Model.copy(profile: Profile): Profile
	return { schemaVersion = 2, coins = profile.coins, xp = profile.xp, lifetimeDeliveries = profile.lifetimeDeliveries,
		owned = table.clone(profile.owned), equipped = table.clone(profile.equipped),
		preferences=table.clone(profile.preferences),tutorialSeen=profile.tutorialSeen }
end
function Model.level(xp: number): number
	local level = 1
	for index, threshold in thresholds do if xp >= threshold then level = index end end
	return level
end
function Model.decode(raw: any): (Row?, string?)
	if raw == nil then return {schemaVersion=2,profile=Model.default(),revision=0,updatedAt=0}, nil end
	if typeof(raw) ~= "table" or (raw.schemaVersion ~= 1 and raw.schemaVersion ~= 2) then return nil,"unsupported_schema" end
	local source = if raw.profile ~= nil then raw.profile else raw
	if typeof(source) ~= "table" or not Model.integer(source.coins) or not Model.integer(source.xp)
		or not Model.integer(if source.lifetimeDeliveries ~= nil then source.lifetimeDeliveries else 0) then return nil,"invalid_currency" end
	if source.schemaVersion ~= nil and source.schemaVersion ~= 1 and source.schemaVersion ~= 2 then return nil,"unsupported_schema" end
	local profile = Model.default()
	profile.coins, profile.xp, profile.lifetimeDeliveries = source.coins, source.xp, if source.lifetimeDeliveries ~= nil then source.lifetimeDeliveries else 0
	local owned = if source.owned ~= nil then source.owned elseif source.ownedCosmetics ~= nil then source.ownedCosmetics else {}
	if typeof(owned) ~= "table" then return nil,"invalid_inventory" end
	local count = 0
	for key, value in owned do
		local id = if typeof(key) == "number" then value else key
		if typeof(id) ~= "string" or #id > 64 or not string.match(id,"^[%w_]+$") or (typeof(key) ~= "number" and value ~= true) then return nil,"invalid_item" end
		profile.owned[id] = true; count += 1
		if count > 100 then return nil,"inventory_too_large" end
	end
	local equipped = if source.equipped ~= nil then source.equipped else {}
	if typeof(equipped) ~= "table" then return nil,"invalid_equipped" end
	for _, slot in {"hat","scooter","badge"} do
		local id = if equipped[slot] ~= nil then equipped[slot] else ""
		if typeof(id) ~= "string" or (#id > 0 and not profile.owned[id]) then return nil,"unowned_equipped" end
		profile.equipped[slot] = id
	end
	if source.preferences ~= nil then
		if typeof(source.preferences)~="table" then return nil,"invalid_preferences" end
		local prefs=source.preferences
		for _,key in {"muted","reducedMotion","largeText","hudMode"}do
			if prefs[key]~=nil and not Model.preference(key,prefs[key])then return nil,"invalid_preference"end
		end
		profile.preferences.muted=if prefs.muted~=nil then prefs.muted else false
		profile.preferences.reducedMotion=if prefs.reducedMotion~=nil then prefs.reducedMotion else false
		profile.preferences.largeText=if prefs.largeText~=nil then prefs.largeText else false
		profile.preferences.hudMode=prefs.hudMode or "auto"
	end
	if source.tutorialSeen~=nil then
		if typeof(source.tutorialSeen)~="boolean" then return nil,"invalid_tutorial_flag" end
		profile.tutorialSeen=source.tutorialSeen
	end
	-- 최초 기획의 기본 스킨은 별도 파트가 없는 기본 외형으로 이행한다.
	local revision = raw.revision or 0
	if not Model.integer(revision) then return nil,"invalid_revision" end
	local lease = raw.lease
	if lease ~= nil and (typeof(lease) ~= "table" or typeof(lease.token) ~= "string" or #lease.token < 1 or #lease.token > 200
		or not Model.integer(lease.expiresAt,1000000000000)) then return nil,"invalid_lease" end
	return {schemaVersion=2,profile=profile,revision=revision,updatedAt=raw.updatedAt or 0,
		lease=if lease then {token=lease.token,expiresAt=lease.expiresAt} else nil},nil
end
function Model.acquire(raw: any, token: string, now: number, ttl: number): (Row?, string?)
	local row, reason = Model.decode(raw)
	if not row then return nil,reason end
	if row.lease and row.lease.token ~= token and row.lease.expiresAt > now then return nil,"locked" end
	row.lease = {token=token,expiresAt=now+ttl}
	row.updatedAt = now
	return row,nil
end
function Model.write(raw: any, token: string, profile: Profile, now: number, ttl: number, release: boolean): (Row?, string?)
	local row, reason = Model.decode(raw)
	if not row then return nil,reason end
	if not row.lease or row.lease.token ~= token or row.lease.expiresAt <= now then return nil,"lease_lost" end
	row.profile, row.revision, row.updatedAt = Model.copy(profile), row.revision+1, now
	row.lease = if release then nil else {token=token,expiresAt=now+ttl}
	return row,nil
end
function Model.purchase(profile: Profile, item: any): (boolean,string)
	if not item then return false,"없는 상품입니다" end
	if profile.owned[item.id] then return false,"이미 보유하고 있습니다" end
	local count=0;for _ in profile.owned do count+=1 end
	if count>=100 then return false,"보관함이 가득 찼습니다" end
	if Model.level(profile.xp) < item.level then return false,"레벨이 부족합니다" end
	if profile.coins < item.price then return false,"Coins가 부족합니다" end
	profile.coins -= item.price; profile.owned[item.id] = true
	return true,"구매 완료 · 장착을 눌러주세요"
end
function Model.equip(profile: Profile, item: any, enabled: boolean): (boolean,string)
	if not item or not profile.owned[item.id] then return false,"보유하지 않은 상품입니다" end
	profile.equipped[item.slot] = if enabled then item.id else ""
	return true,if enabled then "장착했습니다" else "해제했습니다"
end
return Model
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">ProfileStore</string>
            <string name="Source"><![CDATA[--!strict
local Model = require(script.Parent.ProfileModel)
local Store = {}
Store.__index = Store
export type Session = { profile: Model.Profile, mode: string, reason: string, expiresAt: number,
	version: number, dirty: boolean, busy: boolean, closing: boolean }
type Settings = { adapter: any, now: () -> number, waitFor: (number) -> any, token: string, ttl: number, guard: number }
export type Runtime = typeof(setmetatable({} :: Settings, Store))
-- adapter: UpdateAsync. clocks/wait는 테스트에서 주입하며, 콜백 내부에서는 yield하지 않는다.
function Store.new(adapter: any, now: () -> number, waitFor: (number) -> any, token: string): Runtime
	return setmetatable({adapter=adapter,now=now,waitFor=waitFor,token=token,ttl=180,guard=30},Store)
end
function Store.request(self: Runtime, key: string, transform: (any) -> (Model.Row?, string?)): (Model.Row?, string?)
	local errorReason = "request_failed"
	for attempt=1,3 do
		local reason: string? = nil
		local ok,result = pcall(function()
			return self.adapter:UpdateAsync(key,function(old,info)
				local nextRow, why = transform(old)
				reason = why
				if nextRow and info then return nextRow,info:GetUserIds(),info:GetMetadata() end
				return nextRow
			end)
		end)
		if ok then return result,reason end
		errorReason = "request_failed"
		if attempt < 3 then self.waitFor(2^(attempt-1)) end
	end
	return nil,errorReason
end
function Store.load(self: Runtime, id: number): Session
	local row,reason = self:request("User_"..id,function(old) return Model.acquire(old,self.token,self.now(),self.ttl) end)
	if row and not reason then
		row,reason=Model.decode(row)
		if row and (not row.lease or row.lease.token~=self.token or row.lease.expiresAt<=self.now()+self.guard) then row,reason=nil,"locked" end
	end
	if not row or reason then return {profile=Model.default(),mode="SESSION",reason=reason or "load_failed",expiresAt=0,version=0,dirty=false,busy=false,closing=false} end
	local lease=row.lease
	assert(lease,"Acquired profile must have a lease")
	return {profile=Model.copy(row.profile),mode="READY",reason="",expiresAt=lease.expiresAt,version=0,dirty=false,busy=false,closing=false}
end
function Store.writable(self: Runtime, record: Session): boolean
	if record.mode ~= "READY" and record.mode ~= "SAVE_ERROR" then return false end
	if self.now() >= record.expiresAt-self.guard then
		record.mode,record.reason,record.dirty = "SESSION","lease_expired",false
		return false
	end
	return not record.closing
end
function Store.save(self: Runtime, id: number, record: Session, release: boolean): boolean
	if record.busy or (record.mode ~= "READY" and record.mode ~= "SAVE_ERROR") then return false end
	if self.now() >= record.expiresAt-self.guard then record.mode,record.reason="SESSION","lease_expired";return false end
	record.busy = true
	local snapshot,version = Model.copy(record.profile),record.version
	local row,reason = self:request("User_"..id,function(old)
		if record.mode=="SESSION" then return nil,"lease_lost" end
		return Model.write(old,self.token,snapshot,self.now(),self.ttl,release)
	end)
	record.busy = false
	-- 늦게 온 성공 응답이 이미 세션 전용으로 전환된 핸들의 쓰기 권한을 되살리지 않는다.
	if record.mode=="SESSION" then return false end
	if not row or reason then
		if reason == "request_failed" then record.mode="SAVE_ERROR" else record.mode="SESSION" end
		record.reason = reason or "save_failed"
		return false
	end
	local lease=row.lease
	if not release and not lease then record.mode,record.reason="SESSION","lease_lost";return false end
	record.expiresAt = if lease then lease.expiresAt else 0
	record.dirty = record.version ~= version
	record.mode,record.reason = if release then "CLOSED" else "READY",""
	return true
end
return Store
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">RoundModel</string>
            <string name="Source"><![CDATA[--!strict
-- Roblox 객체에 의존하지 않는 라운드 상태 머신. now는 서버 시간이 주입된다.
local RoundModel = {}
RoundModel.__index = RoundModel

type Settings = { Waiting: number, Preparing: number, Playing: number, Results: number, MaxPlayers: number }
type State = {
	settings: Settings, phase: string, roundId: number, endsAt: number,
	participants: { [number]: boolean }, orderActive: boolean, result: string,
}
export type Model = typeof(setmetatable({} :: State, RoundModel))

function RoundModel.new(settings: Settings): Model
	return setmetatable({ settings = settings, phase = "WAITING", roundId = 0, endsAt = 0,
		participants = {}, orderActive = false, result = "" }, RoundModel)
end

function RoundModel.remove(self: Model, userId: number)
	self.participants[userId] = nil
end

function RoundModel.tick(self: Model, now: number, userIds: { number }): boolean
	if #userIds == 0 then
		local changed = self.endsAt ~= 0 or self.phase ~= "WAITING"
		self.phase, self.endsAt, self.orderActive = "WAITING", 0, false
		table.clear(self.participants)
		return changed
	end
	if self.phase == "WAITING" and self.endsAt == 0 then
		self.endsAt = now + self.settings.Waiting
		return true
	end
	if self.phase == "PLAYING" and next(self.participants) == nil then
		self.phase, self.result, self.orderActive = "RESULTS", "배달 팀이 모두 나갔습니다", false
		self.endsAt = now + self.settings.Results
		return true
	end
	if now < self.endsAt then return false end
	if self.phase == "WAITING" then
		self.roundId += 1
		table.clear(self.participants)
		-- 서버가 제공한 입장 목록에서 최대 4명만 확정한다. 중도 입장은 끼어들지 않는다.
		for index, userId in userIds do
			if index <= self.settings.MaxPlayers then self.participants[userId] = true end
		end
		self.result = ""
		self.phase, self.endsAt = "PREPARING", now + self.settings.Preparing
	elseif self.phase == "PREPARING" then
		self.phase, self.endsAt, self.orderActive = "PLAYING", now + self.settings.Playing, true
	elseif self.phase == "PLAYING" then
		self.phase, self.result, self.orderActive = "RESULTS", "시간 초과 · 배달 실패", false
		self.endsAt = now + self.settings.Results
	elseif self.phase == "RESULTS" then
		self.phase, self.endsAt = "WAITING", now + self.settings.Waiting
		table.clear(self.participants)
	end
	return true
end

function RoundModel.finish(self: Model, now: number, result: string)
	if self.phase ~= "PLAYING" then return end
	self.orderActive, self.phase, self.result = false, "RESULTS", result
	self.endsAt = now + self.settings.Results
end

function RoundModel.complete(self: Model, userId: number, expectedRound: number, now: number): { number }?
	if self.phase ~= "PLAYING" or not self.orderActive or expectedRound ~= self.roundId
		or not self.participants[userId] or now >= self.endsAt then return nil end
	-- 양보/yield 없이 주문을 먼저 닫아 동시 클릭과 중복 보상을 차단한다.
	self.orderActive, self.phase, self.result = false, "RESULTS", "배달 성공!"
	self.endsAt = now + self.settings.Results
	local recipients = {}
	for id in self.participants do table.insert(recipients, id) end
	return recipients
end

return RoundModel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">RoundService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config)
local Catalog = require(Shared.OrderCatalog)
local RoundModel = require(script.Parent.RoundModel)
local OrderModel = require(script.Parent.OrderModel)
local Planner = require(script.Parent.OrderPlanner)
local Security = require(script.Parent.SecurityService)
local Economy = require(script.Parent.EconomyService)
local PlayerStates = require(script.Parent.PlayerStateService)
local Monsters = require(script.Parent.MonsterService)
local Vehicles = require(script.Parent.VehicleService)
local Movement = require(script.Parent.MovementModel)
local ActionLimiter = require(script.Parent.ActionLimiter)
local Data = require(script.Parent.DataService)
local Shop = require(script.Parent.ShopService)
local Cosmetics = require(script.Parent.CosmeticService)
local RoundService = {}
type Destination = { prompt: ProximityPrompt, target: Vector3, door: Part }
type World = { world: Folder, spawn: SpawnLocation, destinations: { [string]: Destination }, fakeCenter: Vector3 }
type Remotes = { State: RemoteEvent, Feedback: RemoteEvent, Snapshot: RemoteFunction, Action: RemoteEvent }

function RoundService.start(world: World, remotes: Remotes, dependencies: any?)
	local model = RoundModel.new(Config.Round)
	local orders: OrderModel.Model? = nil
	local security, economy = Security.new(), Economy.new()
	local playerStates, monsters, vehicles, data, shop, cosmetics
	local limiter = ActionLimiter.new()
	local runners = {}
	local version, elapsed = 0, 0
	local connections = {}
	local holds: { [Player]: { index: number, destination: string, began: number } } = {}
	local function now() return workspace:GetServerTimeNow() end
	local function snapshot(player: Player)
		local spec = orders and orders:current()
		local members = {}
		for _, member in Players:GetPlayers() do
			if model.participants[member.UserId] then
				local status = if playerStates then playerStates:status(member) else { downUntil = 0, protectedUntil = 0 }
				table.insert(members, { name = member.DisplayName, downUntil = status.downUntil })
			end
		end
		local status = if playerStates then playerStates:status(player) else { downUntil = 0, protectedUntil = 0 }
		local target = if spec and spec.kind == "Fake" then world.fakeCenter
			elseif spec then world.destinations[spec.destination].target else nil
		return {
			preferences = if data and data:profile(player) and data:profile(player).preferences then table.clone(data:profile(player).preferences) else {muted=false,reducedMotion=false,largeText=false,hudMode="auto"},
			tutorialSeen = if data and data:profile(player) then data:profile(player).tutorialSeen==true else false,
			level = player:GetAttribute("Level") or 1,
			data = if data then data:status(player) else {mode="LOADING",reason="",dirty=false},
			owned = if data and data:profile(player) then table.clone(data:profile(player).owned) else {},
			equipped = if data and data:profile(player) then table.clone(data:profile(player).equipped) else {},
			vehicle = if vehicles then vehicles:status(player) else { owned = false, seated = false, speed = 0, resetAt = 0 },
			stamina = if runners[player] then runners[player].value else 5,
			downUntil = status.downUntil, protectedUntil = status.protectedUntil, members = members,
			chase = if monsters then monsters:status() else { kind = "", endsAt = 0, targetId = 0 },
			version = version, phase = model.phase, roundId = model.roundId, endsAt = model.endsAt,
			participant = model.participants[player.UserId] == true, playerCount = #Players:GetPlayers(),
			coins = player:GetAttribute("Coins") or 0, xp = player:GetAttribute("XP") or 0,
			result = model.result, reward = player:GetAttribute("RoundReward") or 0,
			orderActive = model.orderActive, target = target,
			orderIndex = if orders then orders.index else 0, orderTitle = if spec then spec.title else "",
			orderHint = if spec then spec.hint else "", orderEndsAt = if orders then orders.expiresAt else 0,
			stage = if orders then orders.stage else "", knocks = if orders then orders.knocks else 0,
			holdUntil = if orders then orders.holdUntil else 0, cooldownUntil = if orders then orders.cooldownUntil else 0,
			hotUntil = if orders and spec and spec.kind == "Giant" then orders.startedAt + Config.Orders.GiantHot else 0,
			late = if orders then orders.late else false, successes = if orders then orders.successes else 0,
			failures = if orders then orders.failures else 0,
		}
	end
	local function publish()
		version += 1
		local spec = orders and orders:current()
		for id, destination in world.destinations do
			local selected = spec and (spec.destination == id or (spec.kind == "Fake" and string.match(id, "^fake_")))
			destination.prompt.Enabled = model.phase == "PLAYING" and selected ~= nil and selected ~= false
				and orders ~= nil and (orders.stage == "ACTIVE" or orders.stage == "CALM")
			destination.prompt.HoldDuration = if spec and spec.kind == "Giant" and orders and orders.late then Config.Orders.GiantCalm else 0.6
			destination.prompt.ActionText = if spec and spec.kind == "Ghost" then "문 두드리기"
				elseif spec and spec.kind == "Giant" and orders and orders.late then "진정시키기" else "야식 배달"
		end
		for _, player in Players:GetPlayers() do remotes.State:FireClient(player, snapshot(player)) end
	end
	local function participant(player)
		return model.phase == "PLAYING" and model.participants[player.UserId] == true
	end
	playerStates = if dependencies and dependencies.playerStates then dependencies.playerStates else PlayerStates.new(world.spawn, participant, publish, function(player) security:authorizePosition(player, now()) end)
	monsters = if dependencies and dependencies.monsters then dependencies.monsters else Monsters.new(world.world:FindFirstChild("NPCs"), playerStates, publish)
	local function canRide(player)
		return model.phase == "WAITING" or model.participants[player.UserId] == true
	end
	vehicles = if dependencies and dependencies.vehicles then dependencies.vehicles else Vehicles.new(world.world:FindFirstChild("Vehicles"), playerStates, canRide, publish,
		function(player) security:authorizePosition(player, now()) end)
	playerStates.beforeDown = function(player) vehicles:exit(player) end
	local function dataChanged(player)
		if cosmetics then cosmetics:apply(player) end
		publish()
	end
	data = if dependencies and dependencies.data then dependencies.data else Data.new(economy,dataChanged)
	economy.canMutate = function(player) return data:canEarn(player) end
	economy.onMutation = function(player) data:touch(player) end
	cosmetics = if dependencies and dependencies.cosmetics then dependencies.cosmetics else Cosmetics.new(data,vehicles)
	shop = if dependencies and dependencies.shop then dependencies.shop else Shop.new(data,function(player)cosmetics:apply(player)end)
	local function chase(kind, player, destinationId)
		local destination = world.destinations[destinationId]
		if destination and player then monsters:start(kind, player, destination.target + Vector3.new(0, 0, -10)) end
	end
	local function feedback(message: string)
		for _, player in Players:GetPlayers() do remotes.Feedback:FireClient(player, message) end
	end
	local function award(coins: number, orderId: number)
		for id in model.participants do
			local player = Players:GetPlayerByUserId(id)
			if player and economy:award(player, model.roundId, coins, if orderId == 4 then 0 else Config.Delivery.XP, orderId) then
				player:SetAttribute("RoundReward", (player:GetAttribute("RoundReward") or 0) + coins)
			end
		end
	end
	local function flushOutcome()
		if not orders then return end
		local result = orders:takeOutcome()
		if not result then return end
		monsters:stop()
		if result.success then award(result.reward, result.index) end
		feedback(result.reason .. (if result.success then " · +" .. result.reward .. " Coins" else " · 다음 주문으로 진행"))
		table.clear(holds)
		if not orders:advance(now()) then
			playerStates:clearRound()
			if orders.successes == 3 then award(120, 4) end
			model:finish(now(), string.format("배달 %d/3 성공 · %d건 실패", orders.successes, orders.failures))
		end
	end
	local function add(player: Player)
		economy:add(player)
		runners[player] = { value = 5, exhausted = false, wants = false, inputAt = 0 }
		vehicles:add(player)
		player:SetAttribute("RoundReward", 0)
		player:SetAttribute("Stamina", 5)
		playerStates:add(player)
		cosmetics:add(player)
		data:begin(player)
		publish()
	end
	for _, player in Players:GetPlayers() do add(player) end
	table.insert(connections, Players.PlayerAdded:Connect(add))
	table.insert(connections, Players.PlayerRemoving:Connect(function(player)
		model:remove(player.UserId); security:remove(player); data:remove(player); cosmetics:remove(player); shop:remove(player); economy:remove(player); vehicles:remove(player); playerStates:remove(player)
		runners[player] = nil; limiter:remove(player.UserId)
		holds[player] = nil
		task.defer(publish)
	end))
	remotes.Snapshot.OnServerInvoke = function(player)
		if not security:allowSnapshot(player, now()) then return nil end
		return snapshot(player)
	end
	table.insert(connections, remotes.Action.OnServerEvent:Connect(function(player, payload)
		if not limiter:allow(player.UserId, now()) or typeof(payload) ~= "table" or payload.roundId ~= model.roundId then return end
		if payload.kind=="SetPreference" then data:preference(player,payload.key,payload.value)
		elseif payload.kind=="TutorialComplete" then data:preference(player,"tutorialSeen",true)
		elseif payload.kind == "VehicleInput" then vehicles:input(player, payload.throttle, payload.steer)
		elseif payload.kind == "ResetVehicle" then vehicles:reset(player, true); publish()
		elseif payload.kind == "ExitVehicle" then vehicles:exit(player); publish()
		elseif payload.kind=="PurchaseWithCoins" or payload.kind=="EquipCosmetic" then
			if not playerStates:canAct(player) or vehicles:seated(player) then remotes.Feedback:FireClient(player,"도보 상태에서 상점을 이용하세요");return end
			local _,message = shop:action(player,payload.kind,payload.itemId,payload.enabled)
			remotes.Feedback:FireClient(player,message);publish()
		elseif payload.kind == "Sprint" and typeof(payload.enabled) == "boolean" then
			local runner = runners[player]
			if runner then runner.wants, runner.inputAt = payload.enabled and playerStates:canAct(player), now() end
		end
	end))
	local function inRange(player: Player, destination: Destination): boolean
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then return false end
		local distance = (root.Position - destination.target).Magnitude
		return distance == distance and distance <= Config.Delivery.Distance
	end
	for id, destination in world.destinations do
		table.insert(connections, destination.prompt.PromptButtonHoldBegan:Connect(function(player)
			if not orders or model.phase ~= "PLAYING" or not model.participants[player.UserId] or not playerStates:canAct(player) or not inRange(player, destination) then return end
			holds[player] = { index = orders.index, destination = id, began = now() }
		end))
		table.insert(connections, destination.prompt.Triggered:Connect(function(player)
			if not orders or model.phase ~= "PLAYING" or not model.participants[player.UserId] or now() >= model.endsAt or not playerStates:canAct(player) then return end
			local timestamp = now()
			security:sample(player, timestamp, if vehicles:seated(player) then 46 else 28)
			if not security:canDeliver(player, destination.target, Config.Delivery.Distance, timestamp, Config.Delivery.Cooldown) then return end
			local hold = holds[player]
			local heldFor = if hold and hold.index == orders.index and hold.destination == id then timestamp - hold.began else 0
			holds[player] = nil
			if orders:interact(id, player.UserId, timestamp, heldFor) then
				if orders.stage == "HOLDING" then feedback("뒤돌아보지 마세요! 캐릭터가 문을 향한 채 4초 유지")
				elseif orders.stage == "COOLDOWN" then
					feedback("가짜 집이 깨어났습니다! 도망치세요")
					chase("Fake", player, id)
				end
				flushOutcome(); publish()
			end
		end))
	end
	local function ghostHolderValid(): boolean
		if not orders or not orders.holder then return false end
		local player = Players:GetPlayerByUserId(orders.holder)
		if not player or not model.participants[player.UserId] or not playerStates:canAct(player) then return false end
		local dest = world.destinations.ghost_house
		if not inRange(player, dest) then return false end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") then return false end
		if (root.Position - dest.target).Magnitude > 10 then return false end
		local direction = dest.door.Position - root.Position
		local flat = Vector3.new(direction.X, 0, direction.Z)
		return flat.Magnitude > 0.1 and root.CFrame.LookVector:Dot(flat.Unit) >= 0.55
	end
	table.insert(connections, RunService.Heartbeat:Connect(function(delta)
		elapsed += delta
		if elapsed < 0.1 then return end
		elapsed = 0
		data:tick()
		playerStates:tick()
		monsters:tick()
		local timestamp, ids = now(), {}
		for _, player in Players:GetPlayers() do
			security:sample(player, timestamp, if vehicles:seated(player) then 46 else 28)
			local runner = runners[player]
			local root, humanoid = playerStates:root(player)
			if runner and root and humanoid then
				local velocity = root.AssemblyLinearVelocity or Vector3.zero
				local speed = Movement.stamina(runner, runner.wants and timestamp - runner.inputAt < 0.6,
					Vector3.new(velocity.X,0,velocity.Z).Magnitude > 1, playerStates:canAct(player) and not vehicles:seated(player), 0.1)
				if math.abs((player:GetAttribute("Stamina") or 5) - runner.value) > 0.2 then player:SetAttribute("Stamina", runner.value) end
				if playerStates:canAct(player) then humanoid.WalkSpeed = speed end
			end
			if data:loaded(player) then table.insert(ids, player.UserId) end
		end
		for player, hold in holds do
			local dest = world.destinations[hold.destination]
			if not orders or hold.index ~= orders.index or not dest or not playerStates:canAct(player) or not inRange(player, dest) then holds[player] = nil end
		end
		table.sort(ids)
		local oldPhase = model.phase
		local changed = model:tick(timestamp, ids)
		if model.phase ~= "PLAYING" and oldPhase == "PLAYING" then monsters:stop(); playerStates:clearRound() end
		if model.phase == "PREPARING" and oldPhase == "WAITING" then
			orders = OrderModel.new(Config.Orders, Planner.create(model.roundId, Catalog.FakeHouses))
			orders:advance(timestamp + Config.Round.Preparing)
			for _, player in Players:GetPlayers() do player:SetAttribute("RoundReward", 0) end
			table.clear(holds)
		elseif model.phase == "WAITING" and oldPhase ~= "WAITING" then orders = nil; table.clear(holds) end
		if model.phase == "PLAYING" and orders then
			local oldStage, previousHolder = orders.stage, orders.holder
			if orders:tick(timestamp, ghostHolderValid()) then
				changed = true
				if orders.stage == "COOLDOWN" and oldStage == "HOLDING" then
					feedback("유령이 쫓아옵니다! 도망친 뒤 다시 노크하세요")
					chase("Ghost", if previousHolder then Players:GetPlayerByUserId(previousHolder) else nil, "ghost_house")
				elseif orders.stage == "CALM" then
					feedback("거인이 나왔습니다! 도망치거나 현관에서 진정시키세요")
					local nearest, distance = nil, math.huge
					for _, candidate in Players:GetPlayers() do
						if playerStates:canChase(candidate) then
							local root = playerStates:root(candidate)
							local d = (root.Position - world.destinations.giant_house.target).Magnitude
							if d < distance then nearest, distance = candidate, d end
						end
					end
					chase("Giant", nearest, "giant_house")
				end
				flushOutcome()
			end
		end
		if changed then publish() end
	end))
	publish()
	return function()
		for _, connection in connections do connection:Disconnect() end
		cosmetics:destroy()
		vehicles:destroy()
		monsters:destroy()
		playerStates:destroy()
		remotes.Snapshot.OnServerInvoke = nil
		for _, dest in world.destinations do dest.prompt.Enabled = false end
		data:shutdown()
	end
end
return RoundService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">SecurityService</string>
            <string name="Source"><![CDATA[--!strict
local Security = {}
Security.__index = Security
type Record = { character: Model, position: Vector3, time: number, blockedUntil: number, credit: number }
type State = { records: { [Player]: Record }, requests: { [Player]: number }, interactions: { [Player]: number } }
type Service = typeof(setmetatable({} :: State, Security))

function Security.new(): Service
	return setmetatable({ records = {}, requests = {}, interactions = {} }, Security)
end

function Security.remove(self: Service, player: Player)
	self.records[player], self.requests[player], self.interactions[player] = nil, nil, nil
end

function Security.allowSnapshot(self: Service, player: Player, now: number): boolean
	local last = self.requests[player] or -math.huge
	if now - last < 1 then return false end
	self.requests[player] = now
	return true
end

function Security.sample(self: Service, player: Player, now: number, allowedSpeed: number?)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		self.records[player] = nil
		return
	end
	local position = root.Position
	-- NaN/Infinity가 거리 비교를 우회하지 못하도록 위치를 먼저 검사한다.
	if position.X ~= position.X or position.Y ~= position.Y or position.Z ~= position.Z
		or math.abs(position.X) > 1e6 or math.abs(position.Y) > 1e6 or math.abs(position.Z) > 1e6 then
		self.records[player] = nil
		return
	end
	local record = self.records[player]
	if not record or record.character ~= character then
		self.records[player] = { character = character, position = position, time = now, blockedUntil = now + 2, credit = 12 }
		return
	end
	-- 허용 속도는 서버가 확인한 좌석 소유/탑승 상태에서만 확장한다.
	local delta = position - record.position
	local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
	local speed=allowedSpeed or 28
	local available=record.credit+speed*math.max(0,now-record.time)
	if horizontal>available then
		record.blockedUntil=now+math.max(3,horizontal/speed)
		record.credit=0
	else record.credit=math.min(12,available-horizontal)end
	record.position, record.time = position, now
end

function Security.authorizePosition(self: Service, player: Player, now: number)
	self.records[player] = nil
	self:sample(player, now)
	local record = self.records[player]
	if record then record.blockedUntil = now + 0.5 end
end

function Security.canDeliver(self: Service, player: Player, target: Vector3, maxDistance: number, now: number, cooldown: number): boolean
	local record = self.records[player]
	if not record or now < record.blockedUntil then return false end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then return false end
	local distance = (root.Position - target).Magnitude
	if distance ~= distance or distance > maxDistance then return false end
	if now - (self.interactions[player] or -math.huge) < cooldown then return false end
	self.interactions[player] = now
	return true
end

return Security
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
local Catalog = require(game:GetService("ReplicatedStorage").Shared.Catalogs)
local Profile = require(script.Parent.ProfileModel)
local Service = {}
Service.__index=Service
function Service.new(data,apply) return setmetatable({data=data,apply=apply,last={}},Service) end
function Service:action(player,kind,id,enabled): (boolean,string)
	if typeof(id)~="string" or #id>64 or (kind=="EquipCosmetic" and typeof(enabled)~="boolean") then return false,"잘못된 요청입니다" end
	if not self.data:canShop(player) then return false,"저장 연결이 준비되지 않아 상점이 잠겼습니다" end
	local now=workspace:GetServerTimeNow()
	if now-(self.last[player] or -math.huge)<0.4 then return false,"잠시 후 다시 눌러주세요" end
	self.last[player]=now
	local item=nil
	for _,entry in Catalog do if entry.id==id then item=entry;break end end
	if not item then return false,"없는 상품입니다" end
	local profile=self.data:profile(player)
	if not profile then return false,"프로필 로딩 중입니다" end
	local ok,message
	if kind=="PurchaseWithCoins" then ok,message=Profile.purchase(profile,item)
	elseif kind=="EquipCosmetic" then ok,message=Profile.equip(profile,item,enabled)
	else return false,"허용되지 않은 요청입니다" end
	if ok then self.data:touch(player);self.data:queueSave(player);self.apply(player) end
	return ok,message
end
function Service:remove(player) self.last[player]=nil end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">VehicleService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
local Motion = require(script.Parent.MovementModel)
local Factory = require(script.Parent.Parent.World.VehicleFactory)
local Service = {}
Service.__index = Service
type Actor = { model: Model, seat: VehicleSeat, prompt: ProximityPrompt }
type Slot = { actor: Actor, owner: Player?, home: CFrame, frame: CFrame, yaw: number, speed: number,
	throttle: number, steer: number, inputAt: number, riding: boolean }
type States = { root: (any,Player) -> (BasePart?,Humanoid?), canAct: (any,Player) -> boolean }
type Store = { slots: { Slot }, states: States, canUse: (Player) -> boolean, changed: () -> (), authorizedMove: (Player) -> (),
	connections: { RBXScriptConnection }, cooldowns: { [Player]: number }, stopped: boolean, elapsed: number }
export type Runtime = typeof(setmetatable({} :: Store, Service))
function Service.new(parent: Instance, states: States, canUse: (Player) -> boolean, changed: () -> (), authorizedMove: (Player) -> ()): Runtime
	local self: Runtime = setmetatable({ slots = {}, states = states, canUse = canUse, changed = changed,
		authorizedMove = authorizedMove, connections = {}, cooldowns = {}, stopped = false, elapsed = 0 }, Service)
	for id = 1, 4 do
		local frame = CFrame.new((id - 2.5) * 12, Config.Map.Spawn.Y + 2, Config.Map.Spawn.Z + 20) * CFrame.Angles(0,math.pi,0)
		local actor = Factory.create(parent, id, frame)
		local slot: Slot = { actor = actor, owner = nil, home = frame, frame = frame, yaw = math.pi, speed = 0,
			throttle = 0, steer = 0, inputAt = 0, riding = false }
		self.slots[id] = slot
		table.insert(self.connections, actor.prompt.Triggered:Connect(function(player)
			local root, humanoid = states:root(player)
			if slot.owner ~= player or not self.canUse(player) or not states:canAct(player) or not root or not humanoid
				or humanoid.SeatPart or (root.Position - actor.seat.Position).Magnitude > 8 then return end
			actor.seat:Sit(humanoid)
		end))
		table.insert(self.connections, actor.seat:GetPropertyChangedSignal("Occupant"):Connect(function()
			local humanoid = actor.seat.Occupant
			if humanoid then
				local character = humanoid.Parent
				local player = if character and character:IsA("Model") then Players:GetPlayerFromCharacter(character) else nil
				if player ~= slot.owner or not player or not self.canUse(player) or not states:canAct(player) then
					humanoid.Sit = false
					return
				end
			end
			slot.riding = humanoid ~= nil
			slot.throttle, slot.steer, slot.speed = 0, 0, 0
			self.changed()
		end))
	end
	table.insert(self.connections, RunService.Heartbeat:Connect(function(dt)
		self.elapsed += dt
		if self.elapsed < 1/30 then return end
		local step = math.min(self.elapsed,0.05)
		self.elapsed = 0
		self:tick(step)
	end))
	return self
end
function Service.slot(self: Runtime, player: Player): Slot?
	for _, slot in self.slots do if slot.owner == player then return slot end end
	return nil
end
function Service.add(self: Runtime, player: Player)
	if self:slot(player) then return end
	for _, slot in self.slots do
		if not slot.owner then
			slot.owner = player
			slot.actor.model:SetAttribute("OwnerUserId", player.UserId)
			slot.actor.prompt.ObjectText = player.DisplayName .. "의 스쿠터"
			self:skin(player,"")
			return
		end
	end
end
function Service.exit(self: Runtime, player: Player)
	local slot = self:slot(player)
	if not slot then return end
	local occupant = slot.actor.seat.Occupant
	local character = player.Character
	if occupant and character and occupant.Parent == character then
		occupant.Sit = false
		local weld = slot.actor.seat:FindFirstChild("SeatWeld")
		if weld and weld:IsA("Weld") and ((weld.Part1 and weld.Part1:IsDescendantOf(character)) or (weld.Part0 and weld.Part0:IsDescendantOf(character))) then weld:Destroy() end
	end
	slot.speed, slot.throttle, slot.steer, slot.riding = 0, 0, 0, false
end
function Service.reset(self: Runtime, player: Player, manual: boolean): boolean
	local slot = self:slot(player)
	if not slot then return false end
	local timestamp = workspace:GetServerTimeNow()
	if manual and (not self.canUse(player) or not self.states:canAct(player) or timestamp < (self.cooldowns[player] or 0)) then return false end
	if manual then self.cooldowns[player] = timestamp + Config.Vehicle.ResetCooldown end
	local wasRiding = slot.riding
	self:exit(player)
	-- 소유자의 SeatWeld를 제거한 뒤 복구한다. 서버 내 지연 작업은 소유권/종료 상태를 재검사한다.
	task.defer(function()
		if self.stopped or slot.owner ~= player then return end
		slot.frame, slot.yaw = slot.home, math.pi
		slot.actor.model:PivotTo(slot.frame)
		if wasRiding and player.Character then
			player.Character:PivotTo(slot.home * CFrame.new(5,2,0))
			self.authorizedMove(player)
		end
	end)
	self.changed()
	return true
end
function Service.remove(self: Runtime, player: Player)
	local slot = self:slot(player)
	if slot then
		self:exit(player)
		slot.owner = nil
		slot.actor.model:SetAttribute("OwnerUserId", 0)
		slot.actor.model:PivotTo(slot.home)
		slot.frame, slot.yaw = slot.home, math.pi
	end
	self.cooldowns[player] = nil
	for _, waiting in Players:GetPlayers() do if waiting ~= player then self:add(waiting) end end
end
function Service.input(self: Runtime, player: Player, throttle: any, steer: any): boolean
	local slot = self:slot(player)
	if not slot or not Motion.input(throttle,steer) or not self.canUse(player) or not self.states:canAct(player) then return false end
	local _, humanoid = self.states:root(player)
	if not humanoid or not self:seated(player) then return false end
	slot.throttle, slot.steer, slot.inputAt = throttle, steer, workspace:GetServerTimeNow()
	return true
end
function Service.seated(self: Runtime, player: Player): boolean
	local slot = self:slot(player)
	local root, humanoid = self.states:root(player)
	return slot ~= nil and root ~= nil and humanoid ~= nil and humanoid.Sit and humanoid.SeatPart == slot.actor.seat
		and slot.actor.seat.Occupant == humanoid and (root.Position - slot.actor.seat.Position).Magnitude <= 12
end
function Service.skin(self: Runtime, player: Player, id: string)
	local slot = self:slot(player)
	if not slot then return end
	local body = slot.actor.model:FindFirstChild("Body")
	if body and body:IsA("BasePart") then body.Color = if id=="scooter_mint" then Color3.fromRGB(99,216,184) else Color3.fromRGB(255,170,69) end
	slot.actor.model:SetAttribute("SkinId",id)
end
function Service.status(self: Runtime, player: Player)
	local slot = self:slot(player)
	return { owned = slot ~= nil, seated = self:seated(player), speed = if slot then math.abs(slot.speed) else 0,
		resetAt = self.cooldowns[player] or 0 }
end
function Service.tick(self: Runtime, dt: number)
	if self.stopped or dt <= 0 then return end
	for _, slot in self.slots do
		local player = slot.owner
		if not player then continue end
		if not self:seated(player) or not self.canUse(player) or not self.states:canAct(player) then
			if slot.riding then self:exit(player); self.changed() end
			slot.throttle, slot.steer = 0, 0
		end
		if workspace:GetServerTimeNow() - slot.inputAt > 0.4 then slot.throttle, slot.steer = 0, 0 end
		slot.speed = Motion.speed(slot.speed, slot.throttle, dt, Config.Vehicle.MaxSpeed)
		if math.abs((slot.actor.model:GetAttribute("Speed") or 0) - math.abs(slot.speed)) > 0.5 or slot.speed == 0 then slot.actor.model:SetAttribute("Speed", math.abs(slot.speed)) end
		if math.abs(slot.speed) < 0.05 then continue end
		local yaw = slot.yaw - slot.steer * 1.6 * dt * math.sign(slot.speed)
		local frame = CFrame.new(slot.frame.Position) * CFrame.Angles(0,yaw,0)
		local overlap = OverlapParams.new()
		overlap.FilterType, overlap.FilterDescendantsInstances, overlap.RespectCanCollide = Enum.RaycastFilterType.Exclude, { slot.actor.model, player.Character }, true
		if #workspace:GetPartBoundsInBox(frame * CFrame.new(0,0.6,0), Vector3.new(4.5,4.4,7.8), overlap) > 0 then slot.speed = 0; continue end
		local delta = frame.LookVector * slot.speed * dt
		local params = RaycastParams.new()
		params.FilterType, params.FilterDescendantsInstances, params.RespectCanCollide = Enum.RaycastFilterType.Exclude,
			{ slot.actor.model, player.Character }, true
		-- 차체 전체를 sweep하여 옆면/앞면 벽 충돌을 검사한다. 서버 CFrame 순간이동으로 벽을 통과하지 않는다.
		local hit = workspace:Blockcast(frame * CFrame.new(0,0.6,0), Vector3.new(4.5,4.4,7.8), delta, params)
		if hit then slot.speed = 0; continue end
		local proposed = frame.Position + delta
		local ground = workspace:Raycast(proposed + Vector3.new(0,8,0), Vector3.new(0,-35,0), params)
		if not ground or math.abs(proposed.X) > 310 or math.abs(proposed.Z) > 310 or ground.Position.Y < -10 then
			self:reset(player, false); continue
		end
		slot.yaw, slot.frame = yaw, CFrame.new(proposed.X, ground.Position.Y + 3, proposed.Z) * CFrame.Angles(0,yaw,0)
		slot.actor.model:PivotTo(slot.frame)
	end
end
function Service.destroy(self: Runtime)
	self.stopped = true
	for _, connection in self.connections do connection:Disconnect() end
	for _, slot in self.slots do
		if slot.owner then self:exit(slot.owner) end
		slot.actor.model:Destroy()
	end
	table.clear(self.slots)
end
return Service
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">BuildingFactory</string>
            <string name="Source"><![CDATA[--!strict
local P = require(script.Parent.Primitives)
local Factory = {}
local navy, orange = Color3.fromRGB(27, 39, 64), Color3.fromRGB(255, 170, 69)

function Factory.house(parent: Instance, id: string, origin: Vector3, color: Color3, style: any?): (Model, Part)
	local model = Instance.new("Model")
	model.Name = id
	model:SetAttribute("DestinationId", id)
	model.Parent = parent
	style = style or {}
	local cf = CFrame.new(origin)
	P.part(model, "Foundation", Vector3.new(38, 1, 32), cf * CFrame.new(0, 0.5, 0), navy)
	P.part(model, "Walls", Vector3.new(32, 19, 26), cf * CFrame.new(0, 10.5, 0), Color3.fromRGB(66, 72, 98))
	P.part(model, "Roof", Vector3.new(39, 4, 34), cf * CFrame.new(0, 22, 0) * CFrame.Angles(0, 0, math.rad(-5)), color)
	local door = P.part(model, "Door", Vector3.new(if id == "giant_house" then 10 else 6, if id == "giant_house" then 15 else 10, 0.6), cf * CFrame.new(0, if id == "giant_house" then 8.5 else 6, -13.5), navy)
	P.part(model, "DoorTrim", Vector3.new(8, 0.4, 0.7), cf * CFrame.new(0, 11.4, -13.7), color, Enum.Material.Neon)
	P.part(model, "Porch", Vector3.new(14, 0.5, 8), cf * CFrame.new(0, 0.7, -17), Color3.fromRGB(102, 104, 123))
	for _, x in { -10, 10 } do
		P.part(model, "Window", Vector3.new(5, 6, 0.4), cf * CFrame.new(x, 11, -13.4), Color3.fromRGB(170, 139, 255), Enum.Material.Neon)
		P.part(model, "WindowBar", Vector3.new(0.35, 6.4, 0.6), cf * CFrame.new(x, 11, -13.7), navy)
	end
	P.part(model, "MailPost", Vector3.new(0.8, 4, 0.8), cf * CFrame.new(11, 2, -23), navy)
	P.part(model, "StarMailbox", Vector3.new(3, 2, 2), cf * CFrame.new(11, 4.5, -23), style.mailboxColor or orange)
	P.sign(model, style.label or (id == "ghost_house" and "01 · 파란 지붕집" or "02 · 거인의 집"), cf * CFrame.new(0, if id == "giant_house" then 18 else 16, -13.6), Vector3.new(17, 3, 0.4), color)
	if style.symbol then
		P.sign(model, style.symbol, cf * CFrame.new(11, 4.5, -24.1), Vector3.new(3, 2, 0.2), Color3.new(1, 1, 1))
	end
	P.part(model, "PorchLamp", Vector3.new(2, 1, 1), cf * CFrame.new(0, 12.5, -14), style.lampColor or orange, Enum.Material.Neon)
	return model, door
end

function Factory.headquarters(parent: Instance, origin: Vector3)
	local model = Instance.new("Model")
	model.Name, model.Parent = "Headquarters", parent
	local cf = CFrame.new(origin) * CFrame.Angles(0, math.pi, 0)
	P.part(model, "Floor", Vector3.new(64, 1, 40), cf * CFrame.new(0, 0.5, 0), navy)
	P.part(model, "BackWall", Vector3.new(64, 20, 2), cf * CFrame.new(0, 11, 19), navy)
	for _, x in { -31, 31 } do
		P.part(model, "SideWall", Vector3.new(2, 20, 40), cf * CFrame.new(x, 11, 0), navy)
	end
	P.part(model, "Roof", Vector3.new(70, 2, 46), cf * CFrame.new(0, 22, 0), navy)
	P.part(model, "NeonAwning", Vector3.new(70, 0.6, 1), cf * CFrame.new(0, 21, -23), orange, Enum.Material.Neon)
	P.part(model, "Counter", Vector3.new(35, 4, 6), cf * CFrame.new(0, 3, 8), Color3.fromRGB(160, 88, 52))
	P.sign(model, "야식 본부 / MIDNIGHT", cf * CFrame.new(0, 17, -21), Vector3.new(54, 6, 0.6), orange)
	P.sign(model, "접수 / 주문카드를 확인하세요", cf * CFrame.new(0, 8, 4.8), Vector3.new(30, 3, 0.5), Color3.fromRGB(99, 216, 232))
	for index = 1, 4 do
		local x = (index - 2.5) * 10
		P.part(model, "ParkingBay", Vector3.new(8, 0.12, 12), cf * CFrame.new(x, 1.1, -10), Color3.fromRGB(48, 62, 83))
	end
end

return Factory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">DecorationFactory</string>
            <string name="Source"><![CDATA[--!strict
local P=require(script.Parent.Primitives)
local Factory={}
function Factory.escapePaths(parent: Instance,id: string,origin: Vector3)
	local model=Instance.new("Model");model.Name=id.."_Paths";model.Parent=parent
	-- 건물 양옆 통로를 뒤쪽 연결로 이어 막다른 구석을 줄인다. 실제 추격 동선은 Studio에서 검증한다.
	for _,side in {-1,1}do
		P.part(model,"SidePath",Vector3.new(8,0.12,66),CFrame.new(origin.X+side*24,0.22,origin.Z+2),Color3.fromRGB(72,84,102),Enum.Material.Concrete)
	end
	for _,z in {-25,28}do
		P.part(model,"CrossPath",Vector3.new(56,0.12,8),CFrame.new(origin.X,0.22,origin.Z+z),Color3.fromRGB(72,84,102),Enum.Material.Concrete)
	end
end
function Factory.headquarters(parent: Instance,origin: Vector3)
	local model=Instance.new("Model");model.Name="HeadquartersDetails";model.Parent=parent
	local orange=Color3.fromRGB(255,170,69)
	local frame=CFrame.new(origin)*CFrame.Angles(0,math.pi,0)
	P.sign(model,"영업 중 / NIGHT SHIFT",frame*CFrame.new(-20,9,-21),Vector3.new(16,3,0.4),Color3.fromRGB(99,216,184))
	for x=-12,12,8 do
		P.part(model,"PizzaBox",Vector3.new(5,0.7,4),frame*CFrame.new(x,5.3,8),orange)
	end
	local clerk=Instance.new("Model");clerk.Name="ShopGuide";clerk.Parent=model
	local cf=frame*CFrame.new(22,0,9)
	P.part(clerk,"Apron",Vector3.new(3.5,4,2),cf*CFrame.new(0,5,0),Color3.fromRGB(27,39,64))
	local head=P.part(clerk,"Head",Vector3.new(2.8,2.8,2.8),cf*CFrame.new(0,8.5,0),Color3.fromRGB(245,207,164));head.Shape=Enum.PartType.Ball
	P.part(clerk,"Cap",Vector3.new(3.1,0.5,3.1),cf*CFrame.new(0,10,0),orange)
	for _,x in {-0.6,0.6}do P.part(clerk,"Eye",Vector3.new(0.3,0.4,0.2),cf*CFrame.new(x,8.7,-1.35),Color3.fromRGB(27,39,64))end
	P.sign(clerk,"꾸미기 안내\n상단 메뉴 → 상점",cf*CFrame.new(0,3,-1.2),Vector3.new(10,4,0.3),orange)
	for _,part in clerk:GetDescendants()do if part:IsA("BasePart")then part.CanCollide=false end end
end
return Factory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">MonsterFactory</string>
            <string name="Source"><![CDATA[--!strict
local P = require(script.Parent.Primitives)
local Factory = {}

function Factory.create(parent: Instance, kind: string, position: Vector3)
	local model = Instance.new("Model")
	model.Name = "Midnight" .. kind
	local giant, house = kind == "Giant", kind == "Fake"
	local color = if giant then Color3.fromRGB(255, 175, 90) elseif house then Color3.fromRGB(156, 112, 207) else Color3.fromRGB(130, 215, 255)
	local root = P.part(model, "HumanoidRootPart", Vector3.new(3, 4, 3), CFrame.new(position), color)
	root.Transparency, root.CanCollide = 1, false
	local body = P.part(model, "Torso", if giant then Vector3.new(7, 8, 5) elseif house then Vector3.new(7, 6, 6) else Vector3.new(4, 5, 4), CFrame.new(position), color)
	body.CanCollide = true
	if not giant and not house then body.Shape, body.Transparency = Enum.PartType.Ball, 0.2 end
	local head = P.part(model, "Head", Vector3.new(4, 3, 3), CFrame.new(position + Vector3.new(0, 4.5, 0)), color)
	head.Shape = Enum.PartType.Ball
	for _, x in { -0.9, 0.9 } do
		local eye = P.part(model, "Eye", Vector3.new(0.6, 0.8, 0.35), CFrame.new(position + Vector3.new(x, 4.8, -1.5)), Color3.fromRGB(27, 39, 64), Enum.Material.Neon)
		eye.CanCollide = false
	end
	P.part(model, "Smile", Vector3.new(1.7, 0.25, 0.3), CFrame.new(position + Vector3.new(0, 3.8, -1.5)), Color3.fromRGB(27, 39, 64))
	if house then
		P.part(model, "Roof", Vector3.new(9, 2, 8), CFrame.new(position + Vector3.new(0, 3.5, 0)), Color3.fromRGB(80, 60, 122))
		for _, x in { -2, 2 } do P.part(model, "Foot", Vector3.new(2.4, 1.5, 4), CFrame.new(position + Vector3.new(x, -3.5, 0)), color) end
	elseif giant then
		for _, x in { -4.5, 4.5 } do P.part(model, "Arm", Vector3.new(2, 6, 2), CFrame.new(position + Vector3.new(x, 0, 0)), color) end
	else
		for _, x in { -1.4, 0, 1.4 } do
			P.part(model, "GhostTail", Vector3.new(1.2, 2, 1.5), CFrame.new(position + Vector3.new(x, -2.3, 0)), color)
		end
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.RequiresNeck, humanoid.BreakJointsOnDeath, humanoid.DisplayDistanceType = false, false, Enum.HumanoidDisplayDistanceType.None
	humanoid.WalkSpeed, humanoid.HipHeight, humanoid.Parent = if giant then 19 else 20, if giant or house then 3 else 2, model
	model.PrimaryPart = root
	-- 모든 장식은 한 물리 어셈블리에 용접한다. 외부 리그/애니메이션 ID에 의존하지 않는다.
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored, part.CanTouch = false, false
			if part ~= root then
				part.Massless = true
				if part ~= body then part.CanCollide = false end
				local weld = Instance.new("WeldConstraint")
				weld.Part0, weld.Part1, weld.Parent = root, part, root
			end
		end
	end
	model.Parent = parent
	return { model = model, root = root, humanoid = humanoid }
end
return Factory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">NavigationSigns</string>
            <string name="Source"><![CDATA[--!strict
local P = require(script.Parent.Primitives)
local Navigation = {}

function Navigation.create(parent: Instance, name: string, position: Vector3, target: Vector3, color: Color3)
	local model = Instance.new("Model")
	model.Name, model.Parent = name, parent
	local flat = Vector3.new(target.X, position.Y, target.Z)
	-- 문자 화살표는 보는 면에 따라 반대로 보인다. 실제 목적지 방향의 3D 화살표를 만든다.
	local delta = flat - position
	local yaw = math.atan2(-delta.X, -delta.Z)
	local frame = CFrame.new(position) * CFrame.Angles(0, yaw, 0)
	model:SetAttribute("TargetPosition", target)
	local shaft = P.part(model, "ArrowShaft", Vector3.new(0.7, 0.2, 8), frame, color, Enum.Material.Neon)
	shaft.CanCollide = false
	for _, side in { -1, 1 } do
		local head = P.part(model, "ArrowHead", Vector3.new(0.7, 0.2, 4), frame * CFrame.new(side * 1.2, 0, -3) * CFrame.Angles(0, side * math.rad(40), 0), color, Enum.Material.Neon)
		head.CanCollide = false
	end
	P.sign(model, "01 · 파란 지붕집", CFrame.new(position + Vector3.new(0, 6, 0)), Vector3.new(22, 4, 0.6), color, true)
	return model
end
return Navigation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Primitives</string>
            <string name="Source"><![CDATA[--!strict
local Primitives = {}

function Primitives.part(parent: Instance, name: string, size: Vector3, frame: CFrame, color: Color3, material: Enum.Material?): Part
	local part = Instance.new("Part")
	part.Name, part.Size, part.CFrame = name, size, frame
	part.Color, part.Material = color, material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

function Primitives.sign(parent: Instance, text: string, frame: CFrame, size: Vector3, color: Color3, doubleSided: boolean?): Part
	local part = Primitives.part(parent, "Sign", size, frame, Color3.fromRGB(17, 25, 44))
	local surface = Instance.new("SurfaceGui")
	surface.Face, surface.PixelsPerStud = Enum.NormalId.Front, 36
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.Parent = part
	local label = Instance.new("TextLabel")
	label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
	label.Text, label.TextColor3, label.TextScaled = text, color, true
	label.Font = Enum.Font.GothamBold
	label.Parent = surface
	if doubleSided then
		local back = surface:Clone()
		back.Face, back.Parent = Enum.NormalId.Back, part
	end
	return part
end

return Primitives
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">VehicleFactory</string>
            <string name="Source"><![CDATA[--!strict
local P = require(script.Parent.Primitives)
local Factory = {}
function Factory.create(parent: Instance, id: number, frame: CFrame)
	local model = Instance.new("Model")
	model.Name = "Scooter" .. id
	model:SetAttribute("VehicleId", id)
	model:SetAttribute("OwnerUserId", 0)
	local orange = Color3.fromRGB(255, 170, 69)
	local navy = Color3.fromRGB(27, 39, 64)
	local seat = Instance.new("VehicleSeat")
	seat.Name, seat.Size, seat.CFrame = "DriverSeat", Vector3.new(2.2, 0.8, 2.2), frame
	seat.Anchored, seat.CanTouch, seat.HeadsUpDisplay = true, false, false
	seat.Color, seat.Parent = navy, model
	P.part(model, "Body", Vector3.new(3, 1.3, 6), frame * CFrame.new(0,-0.7,0), orange)
	P.part(model, "Deck", Vector3.new(3.4,0.35,4), frame * CFrame.new(0,-1,-0.5), navy)
	P.part(model, "Stem", Vector3.new(0.4,2.3,0.4), frame * CFrame.new(0,0.6,-2), navy)
	P.part(model, "Handlebar", Vector3.new(4.3,0.4,0.4), frame * CFrame.new(0,1.7,-2), navy)
	for _, z in {-2.5,2.5} do
		local wheel = P.part(model, "Wheel", Vector3.new(1,2.6,2.6), frame * CFrame.new(0,-1.4,z), Color3.fromRGB(20,23,31))
		wheel.Shape = Enum.PartType.Cylinder
	end
	local lamp = P.part(model, "Headlight", Vector3.new(1.5,1.5,0.7), frame * CFrame.new(0,0.4,-3.1), Color3.fromRGB(255,239,180), Enum.Material.Neon)
	lamp.Shape = Enum.PartType.Ball
	P.part(model, "DeliveryBox", Vector3.new(3.5,2.8,2.6), frame * CFrame.new(0,1.1,2.1), navy)
	P.sign(model, "야식 / " .. id, frame * CFrame.new(0,1.3,3.45) * CFrame.Angles(0,math.pi,0), Vector3.new(3.2,1.5,0.2), orange)
	local attach = Instance.new("Attachment")
	attach.Position, attach.Parent = Vector3.new(0,1.5,-1), seat
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText, prompt.ObjectText, prompt.HoldDuration = "스쿠터 탑승", "배달 스쿠터 " .. id, 0.3
	prompt.MaxActivationDistance, prompt.RequiresLineOfSight, prompt.Parent = 8, true, attach
	model.PrimaryPart, model.Parent = seat, parent
	return { model = model, seat = seat, prompt = prompt }
end
return Factory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--!strict
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local P = require(script.Parent.Primitives)
local Building = require(script.Parent.BuildingFactory)
local Navigation = require(script.Parent.NavigationSigns)
local Catalog = require(ReplicatedStorage.Shared.OrderCatalog)
local Decor=require(script.Parent.DecorationFactory)
local WorldBuilder = {}
local cyan = Color3.fromRGB(99, 216, 232)

function WorldBuilder.build()
	local old = workspace:FindFirstChild("GameWorld")
	if old and old:GetAttribute("MidnightGenerated") ~= true then
		error("GameWorld already exists and is not generated by Midnight Delivery; rename it first")
	end
	-- 기존 월드는 새 월드 생성 성공 후에만 교체한다. 라운드마다 맵을 다시 만들지 않는다.
	local world = Instance.new("Folder")
	world.Name = "GameWorld"
	world:SetAttribute("MidnightGenerated", true)
	world:SetAttribute("Seed", Config.Map.Seed)
	local ok, result = pcall(function()
		local folders = {} :: { [string]: Folder }
		for _, name in { "Lobby", "Roads", "Buildings", "Trees", "DeliveryPoints", "NPCs", "Vehicles", "Effects" } do
			local folder = Instance.new("Folder")
			folder.Name, folder.Parent = name, world
			folders[name] = folder
		end
		P.part(world, "Ground", Vector3.new(Config.Map.Size, 4, Config.Map.Size), CFrame.new(0, -2, 0), Color3.fromRGB(28, 45, 43), Enum.Material.Grass)
		local roads = folders.Roads
		P.part(roads, "MainRoad", Vector3.new(30, 0.2, 400), CFrame.new(0, 0.1, 25), Color3.fromRGB(32, 35, 48), Enum.Material.Asphalt)
		P.part(roads, "DeliveryRoad", Vector3.new(250, 0.2, 30), CFrame.new(-105, 0.12, -20), Color3.fromRGB(32, 35, 48), Enum.Material.Asphalt)
		for z = -95, 210, 24 do
			P.part(roads, "CenterMark", Vector3.new(0.5, 0.05, 9), CFrame.new(0, 0.24, z), Color3.fromRGB(255, 213, 137))
		end
		for x = -210, -25, 24 do
			P.part(roads, "CenterMark", Vector3.new(9, 0.05, 0.5), CFrame.new(x, 0.26, -20), Color3.fromRGB(255, 213, 137))
		end
		Building.headquarters(folders.Lobby, Config.Map.Headquarters)
		Decor.headquarters(folders.Lobby,Config.Map.Headquarters)
		local destinations = {}
		local function destination(id, position, color, style)
			local house, door = Building.house(folders.Buildings, id, position, color, style)
			house:SetAttribute("CustomerType", if id == "ghost_house" then "Ghost" elseif id == "giant_house" then "Giant" else "Fake")
			local marker = Instance.new("Attachment")
			marker.Name, marker.Position, marker.Parent = "InteractPoint", Vector3.new(0, 0, -3), door
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name, prompt.ActionText, prompt.ObjectText = "Deliver", "야식 배달", style and style.label or id
			prompt.HoldDuration, prompt.MaxActivationDistance = 0.6, Config.Delivery.Distance
			prompt.RequiresLineOfSight, prompt.Enabled, prompt.Parent = true, false, marker
			destinations[id] = { prompt = prompt, target = door.CFrame:PointToWorldSpace(marker.Position), door = door }
			Decor.escapePaths(roads,id,position)
		end
		destination("ghost_house", Config.Map.GhostHouse, Color3.fromRGB(63, 112, 228), { label = "01 · 파란 지붕집" })
		destination("giant_house", Config.Map.GiantHouse, Color3.fromRGB(255, 170, 69), { label = "02 · 거인의 집" })
		for i, info in Catalog.FakeHouses do
			destination(info.id, Vector3.new(-90 + i * 55, 0, 255), Color3.fromRGB(170, 139, 255), {
				label = info.label, symbol = info.symbol,
				mailboxColor = Color3.fromRGB(table.unpack(info.mailbox)), lampColor = Color3.fromRGB(table.unpack(info.lamp)),
			})
		end
		P.part(roads, "GiantRoad", Vector3.new(200, 0.2, 30), CFrame.new(100, 0.12, 120), Color3.fromRGB(32, 35, 48), Enum.Material.Asphalt)
		P.part(roads, "OuterRoad", Vector3.new(180, 0.2, 30), CFrame.new(20, 0.12, 230), Color3.fromRGB(32, 35, 48), Enum.Material.Asphalt)
		Building.house(folders.Buildings,"convenience_store",Vector3.new(205,0,-65),Color3.fromRGB(99,216,184),{label="24H 야식 편의점 · 길안내"})
		P.part(roads,"StoreRoad",Vector3.new(220,0.2,24),CFrame.new(100,0.12,-94),Color3.fromRGB(32,35,48),Enum.Material.Asphalt)
		P.sign(roads,"배달 구역 끝 / 돌아가기",CFrame.new(0,8,295),Vector3.new(24,4,0.7),cyan,true)
		local spawn = Instance.new("SpawnLocation")
		spawn.Name, spawn.Size, spawn.CFrame = "LobbySpawn", Vector3.new(16, 1, 10), CFrame.new(Config.Map.Spawn) * CFrame.Angles(0, math.pi, 0)
		spawn.Anchored, spawn.Neutral, spawn.Duration = true, true, 3
		spawn.Color, spawn.Material = cyan, Enum.Material.Neon
		spawn.Parent = folders.Lobby
		for z = -105, 195, 60 do
			local base = Vector3.new(21, 0, z)
			P.part(roads, "LampPost", Vector3.new(1, 19, 1), CFrame.new(base + Vector3.new(0, 9.5, 0)), Color3.fromRGB(48, 56, 76))
			local lamp = P.part(roads, "Lamp", Vector3.new(5, 0.7, 3), CFrame.new(base + Vector3.new(-2, 19, 0)), Color3.fromRGB(255, 213, 137), Enum.Material.Neon)
			local light = Instance.new("PointLight")
			light.Brightness, light.Range, light.Color, light.Parent = 1.2, 32, lamp.Color, lamp
		end
		Navigation.create(roads, "BlueHouseGuide", Vector3.new(0, 0.5, -20), destinations.ghost_house.target, cyan)
		local random = Random.new(Config.Map.Seed)
		for i = 1, 55 do
			local x, z = random:NextNumber(-300, -245), random:NextNumber(-250, 290)
			if i % 2 == 0 then x = -x end
			local h = random:NextNumber(15, 27)
			P.part(folders.Trees, "Trunk", Vector3.new(3, h, 3), CFrame.new(x, h / 2, z), Color3.fromRGB(49, 39, 47))
			local crown = P.part(folders.Trees, "Canopy", Vector3.new(16, 18, 16), CFrame.new(x, h, z), Color3.fromRGB(31, 65, 60))
			crown.Shape, crown.CanCollide = Enum.PartType.Ball, false
		end
		return { world = world, spawn = spawn, destinations = destinations, fakeCenter = Vector3.new(20, 6, 235),
			prompt = destinations.ghost_house.prompt, target = destinations.ghost_house.target }
	end)
	if not ok then
		world:Destroy()
		error("World generation failed; seed=" .. Config.Map.Seed .. ": " .. tostring(result))
	end
	if old then old:Destroy() end
	world.Parent = workspace
	Lighting.ClockTime, Lighting.Brightness = 0.7, 2
	Lighting.Ambient, Lighting.OutdoorAmbient = Color3.fromRGB(73, 77, 112), Color3.fromRGB(65, 75, 107)
	Lighting.FogColor, Lighting.FogStart, Lighting.FogEnd = Color3.fromRGB(32, 40, 68), 170, 650
	local bloom = Lighting:FindFirstChild("MidnightBloom")
	if bloom then bloom:Destroy() end
	local effect = Instance.new("BloomEffect")
	effect.Name, effect.Intensity, effect.Size, effect.Threshold = "MidnightBloom", 0.18, 20, 1.4
	effect.Parent = Lighting
	print("[MidnightDelivery] World ready; seed=" .. Config.Map.Seed)
	return result
end

return WorldBuilder
]]></string>
