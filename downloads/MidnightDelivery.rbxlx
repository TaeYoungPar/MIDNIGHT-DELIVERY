      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Catalogs</string>
          <string name="Source"><![CDATA[--!strict
-- 가격/해금/꾸미기 슬롯은 서버도 이 카탈로그로 검사한다. Robux 상품은 사용하지 않는다.
return table.freeze({
	{ id = "neon_cap", name = "네온 배달 모자", slot = "hat", price = 120, level = 1, description = "주황 네온 챙 모자" },
	{ id = "scooter_mint", name = "민트 스쿠터", slot = "scooter", price = 180, level = 2, description = "성능 변화 없는 민트 차체" },
	{ id = "ghost_badge", name = "유령 배지", slot = "badge", price = 240, level = 2, description = "작은 보랏빛 유령 배지" },
})
]]></string>
        </Properties>
