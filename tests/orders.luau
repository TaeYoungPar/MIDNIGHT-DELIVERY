--!strict
local Order = require("../src/server/Services/OrderModel")
local Planner = require("../src/server/Services/OrderPlanner")
local Catalog = require("../src/shared/OrderCatalog")
local Economy = require("../src/server/Services/EconomyService")
local settings = { Duration = 120, GhostHold = 4, GhostCooldown = 10, GiantHot = 90, GiantCalm = 3, FakeLock = 10 }
local total = 0
local function test(name, run)
	local ok, err = pcall(run)
	assert(ok, name .. ": " .. tostring(err))
	total += 1; print("PASS " .. name)
end
local function single(kind, dest)
	local m = Order.new(settings, {{kind = kind, destination = dest, title = "", hint = ""}})
	m:advance(0); return m
end
local function knock(m, start)
	assert(m:interact("ghost_house", 1, start, 0))
	assert(m:interact("ghost_house", 1, start + 0.7, 0))
	assert(m:interact("ghost_house", 1, start + 1.4, 0))
end

test("planner always includes three types and varies order and clue", function()
	local a = Planner.create(1, Catalog.FakeHouses)
	local b = Planner.create(2, Catalog.FakeHouses)
	assert(a[1].kind == "Ghost" and b[1].kind == "Giant")
	local kinds = {}; for _, spec in a do kinds[spec.kind] = true end
	assert(kinds.Ghost and kinds.Giant and kinds.Fake)
	assert(a[3].destination == "fake_1" and b[2].destination == "fake_2")
end)
test("ghost shared knock cooldown and four-second hold", function()
	local m = single("Ghost", "ghost_house")
	assert(m:interact("ghost_house", 1, 0, 0))
	assert(not m:interact("ghost_house", 2, 0.2, 0))
	assert(m:interact("ghost_house", 2, 0.7, 0)); assert(m:interact("ghost_house", 1, 1.4, 0))
	assert(m.stage == "HOLDING" and m.holder == 1)
	m:tick(5.39, true); assert(m.stage == "HOLDING")
	m:tick(5.41, true); local result = m:takeOutcome()
	assert(result and result.success and result.reward == 80)
	assert(m:takeOutcome() == nil and not m:interact("ghost_house", 1, 6, 0))
end)
test("ghost turn-away loses hold, locks for ten seconds, then retry", function()
	local m = single("Ghost", "ghost_house"); knock(m, 0)
	m:tick(2, false); assert(m.stage == "COOLDOWN" and m.knocks == 0)
	assert(not m:interact("ghost_house", 1, 11.99, 0))
	m:tick(12, false); knock(m, 12)
	m:tick(18, true); assert(m.successes == 1)
end)
test("ghost third violation fails and produces one outcome", function()
	local m = single("Ghost", "ghost_house")
	for attempt = 0, 2 do
		local t = attempt * 12
		m:tick(t, false); knock(m, t); m:tick(t + 2, false)
	end
	assert(m.failures == 1 and m.stage == "RESOLVED")
	m:tick(120, false); assert(m.failures == 1)
end)
test("giant warm reward and exact ninety-second late boundary", function()
	local m = single("Giant", "giant_house")
	assert(m:interact("giant_house", 1, 89.99, 0))
	assert(m:takeOutcome().reward == 80)
	m = single("Giant", "giant_house")
	assert(not m:interact("giant_house", 1, 90, 0.6))
	assert(not m.late, "failed interaction must not hide the next heartbeat stage change")
	assert(m:tick(90, false) and m.stage == "CALM")
	assert(not m:interact("giant_house", 1, 95, 2.99))
	assert(m:interact("giant_house", 1, 95, 3))
	assert(m:takeOutcome().reward == 56)
end)
test("fake wrong-house lock, correct-house recovery, and two mistakes fail", function()
	local m = single("Fake", "fake_2")
	assert(not m:interact("ghost_house", 1, 1, 0))
	assert(m:interact("fake_1", 1, 1, 0) and m.stage == "COOLDOWN")
	assert(not m:interact("fake_2", 1, 5, 0))
	m:tick(11, false); assert(m:interact("fake_2", 1, 12, 0)); assert(m.successes == 1)
	m = single("Fake", "fake_2")
	m:interact("fake_1", 1, 1, 0); m:tick(11, false); m:interact("fake_3", 1, 12, 0)
	assert(m.failures == 1)
end)
test("order timeout wins over concurrent completion", function()
	local m = single("Giant", "giant_house")
	assert(not m:interact("giant_house", 1, 120, 3))
	m:tick(120, false); assert(m.failures == 1 and not m:takeOutcome().success)
end)
test("three sequential outcomes include partial success and finish", function()
	local m = Order.new(settings, Planner.create(1, Catalog.FakeHouses))
	m:advance(0); knock(m, 0); m:tick(6, true)
	assert(m:takeOutcome().index == 1); assert(m:advance(6))
	m:tick(126, false); assert(not m:takeOutcome().success); assert(m:advance(126))
	m:interact("fake_1", 1, 127, 0); assert(m:takeOutcome().index == 3)
	assert(not m:advance(127) and m.stage == "DONE")
	assert(m.successes == 2 and m.failures == 1)
end)
test("economy pays distinct order keys and all-success bonus once", function()
	local attrs = {}; local p = {UserId = 1, SetAttribute = function(_, k, v) attrs[k] = v end}
	local e = Economy.new(); e:add(p)
	for index = 1, 3 do
		assert(e:award(p, 1, 80, 20, index)); assert(not e:award(p, 1, 80, 20, index))
	end
	assert(e:award(p, 1, 120, 0, 4) and not e:award(p, 1, 120, 0, 4))
	assert(attrs.Coins == 360 and attrs.XP == 60)
end)
print(string.format("%d P2 order tests passed (no Studio run)", total))
